---
interface Props {
  variant?: 'secondary' | 'primary' | 'success' | 'warning' | 'error';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'secondary', size = 'md', class: className = '', ...attrs } = Astro.props;

const variantClasses = {
  secondary: 'bg-canvas-soft text-body',
  primary: 'bg-primary text-on-primary',
  success: 'bg-cyan-soft text-cyan-deep',
  warning: 'bg-warning-soft text-warning-deep',
  error: 'bg-error-soft text-error-deep',
};

const sizeClasses = {
  sm: 'px-2 py-0.5 text-caption',
  md: 'px-2.5 py-1 text-caption',
};

const classes = `inline-flex items-center font-medium rounded-full ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
---

<span class={classes} {...attrs}>
  <slot />
</span>

<style>
  :host {
    display: inline-flex;
  }
</style>
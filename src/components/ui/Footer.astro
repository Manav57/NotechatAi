---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const currentYear = new Date().getFullYear();

const footerLinks = {
  Product: [
    { label: 'Features', href: '/features' },
    { label: 'Pricing', href: '/pricing' },
    { label: 'Docs', href: '/free-beta' },
    { label: 'Blog', href: '/blog' },
  ],
  Company: [
    { label: 'About', href: '/about' },
    { label: 'Contact', href: '/contact' },
    { label: 'Blog', href: '/blog' },
  ],
  Resources: [
    { label: 'Community', href: 'https://discord.gg/noteschatai' },
    { label: 'API Reference', href: '/free-beta' },
    { label: 'Status', href: '/status' },
  ],
  Legal: [
    { label: 'Privacy', href: '/privacy' },
    { label: 'Terms', href: '/terms' },
    { label: 'Cookies', href: '/cookies' },
  ],
};

const socialLinks = [
  { label: 'Twitter', href: 'https://twitter.com/noteschatai', icon: '𝕏' },
  { label: 'GitHub', href: 'https://github.com/noteschatai', icon: '⌘' },
  { label: 'Discord', href: 'https://discord.gg/noteschatai', icon: '💬' },
];
---

<footer class="footer border-t border-hairline {className}" role="contentinfo">
  <div class="max-w-[1400px] mx-auto px-4 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8 lg:gap-12 mb-12 lg:mb-16">
      <div class="col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-6" aria-label="NotesChatAI Home">
          <img src="/logo.svg" alt="NotesChatAI" width="28" height="28" class="rounded-md" />
          <span class="font-display-sm text-ink">NotesChatAI</span>
        </a>
        <p class="font-body-sm text-body max-w-xs">
          Your persistent AI study assistant. Upload once, remember forever.
        </p>
      </div>

      {Object.entries(footerLinks).map(([columnTitle, links]) => (
        <nav aria-label={columnTitle}>
          <h3 class="font-caption-mono uppercase tracking-wider text-mute mb-4">
            {columnTitle}
          </h3>
          <ul class="space-y-3" role="list">
            {links.map((link) => (
              <li>
                <a href={link.href} class="font-body-sm text-body hover:text-ink transition-colors duration-150">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="pt-8 lg:pt-12 border-t border-hairline">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4 md:gap-8">
        <p class="font-body-sm text-mute">
          © {currentYear} NotesChatAI. All rights reserved.
        </p>

        <div class="flex items-center gap-6">
          {socialLinks.map((social) => (
            <a href={social.href} class="font-body-sm text-body hover:text-ink transition-colors duration-150 flex items-center gap-1.5" aria-label={social.label} target="_blank" rel="noopener noreferrer">
              <span aria-hidden="true">{social.icon}</span>
              <span class="hidden sm:inline">{social.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 96px 24px;
  }

  @media (min-width: 1024px) {
    .footer {
      padding: 128px 24px;
    }
  }
</style>
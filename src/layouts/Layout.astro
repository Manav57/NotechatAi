---
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist/700.css';
import '@fontsource/geist-mono/400.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  keywords?: string;
  robots?: string;
  ogType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string, any>;
}

const {
  title = 'NotesChatAI — Your Persistent AI Study Assistant',
  description = 'Upload notes, textbooks, and PDFs once. Chat with an AI that remembers everything across sessions. Build your personal knowledge base that grows with you.',
  ogImage = '/og-image.png',
  keywords = 'AI study assistant, notebooklm alternative, chat with my notes, chat with pdf ai, ai that remembers your notes, ai notebook for students, upload notes ask questions ai, ai study assistant for students, persistent ai memory, chat with your documents ai, ai flashcard generator from notes, free notebooklm alternative',
  robots = 'index, follow',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://noteschatai.com');
const ogImageURL = new URL(ogImage, 'https://noteschatai.com');

const defaultStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'NotesChatAI',
  url: 'https://noteschatai.com',
  description: description,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Cloud',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  author: {
    '@type': 'Organization',
    name: 'NotesChatAI',
    url: 'https://noteschatai.com',
  },
  keywords: keywords,
};

const finalStructuredData = structuredData || defaultStructuredData;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function() {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EDE90R51V7"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-EDE90R51V7');
    </script>

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="NotechatAi" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#171717" />
    <meta name="author" content="NotesChatAI" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="NotesChatAI" />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:site" content="@noteschatai" />
    <meta name="twitter:creator" content="@noteschatai" />

    <!-- Additional SEO hints -->
    <link rel="alternate" hreflang="en" href={canonicalURL} />
    <meta name="application-name" content="NotesChatAI" />
    <meta name="msapplication-TileColor" content="#171717" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(finalStructuredData)} />
  </head>
  <body class="bg-canvas-soft text-ink antialiased dark:bg-[#111111] dark:text-[#ededed]">
    <slot />
  </body>
</html>

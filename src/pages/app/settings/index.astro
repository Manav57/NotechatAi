export const prerender = false;
---
import AppLayout from '../../../layouts/AppLayout.astro';
import Button from '../../../components/ui/Button.astro';
import Badge from '../../../components/ui/Badge.astro';
import Card from '../../../components/ui/Card.astro';
import UpgradeModal from '../../../components/ui/UpgradeModal.astro';

const user = (Astro.locals as any)?.user;
const userName = user?.name || '';
const userEmail = user?.email || '';
const userImage = user?.image || `https://api.dicebear.com/7.x/avataaars/svg?seed=${userName}`;
---

<AppLayout title="Settings — NotesChatAI">
  <div class="max-w-3xl mx-auto space-y-8">
    <div>
      <h1 class="font-display-lg text-ink">Settings</h1>
      <p class="font-body-md text-body mt-1">Manage your account, preferences, and API access.</p>
    </div>

    {/* Settings Tabs */}
    <div class="flex gap-1 border-b border-hairline" role="tablist">
      {[
        { id: 'profile', label: 'Profile' },
        { id: 'preferences', label: 'Preferences' },
        { id: 'billing', label: 'Billing' },
        { id: 'api', label: 'API Keys' },
        { id: 'data', label: 'Data & Export' },
      ].map((tab, i) => (
        <button
          role="tab"
          class:list={[
            'settings-tab px-4 py-2.5 font-body-sm transition-colors -mb-px',
            i === 0
              ? 'text-ink border-b-2 border-primary font-body-sm-strong'
              : 'text-body hover:text-ink border-b-2 border-transparent'
          ]}
          data-tab={tab.id}
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          {tab.label}
        </button>
      ))}
    </div>

    {/* Profile Tab */}
    <div id="tab-profile" class="settings-panel space-y-6" role="tabpanel">
      <Card variant="marketing-large">
        <h2 class="font-display-md text-ink mb-6">Profile Information</h2>
        <div class="flex items-center gap-6 mb-6">
          <div class="relative">
            <img src={userImage} alt="Avatar" class="w-20 h-20 rounded-full" />
            <button class="absolute -bottom-1 -right-1 w-7 h-7 bg-primary text-on-primary rounded-full flex items-center justify-center hover:opacity-90 transition-opacity" aria-label="Change avatar">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M10 2l2 2-7 7H3v-2l7-7z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          <div>
            <p class="font-body-md text-ink font-medium">{userName || 'User'}</p>
            <p class="font-body-sm text-mute">{userEmail}</p>
          </div>
        </div>

        <form class="space-y-4">
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-body-sm-strong text-ink mb-1.5">Full Name</label>
              <input type="text" value={userName} class="input h-10" />
            </div>
            <div>
              <label class="block font-body-sm-strong text-ink mb-1.5">Email</label>
              <input type="email" value={userEmail} class="input h-10" disabled />
              <p class="font-caption text-mute mt-1">Contact support to change your email</p>
            </div>
          </div>
          <div>
            <label class="block font-body-sm-strong text-ink mb-1.5">Display Name</label>
            <input type="text" value={userName} class="input h-10" />
          </div>
          <div class="flex justify-end pt-2">
            <Button type="submit" variant="primary">Save Changes</Button>
          </div>
        </form>
      </Card>

      <Card variant="marketing-large">
        <h2 class="font-display-md text-ink mb-4">Danger Zone</h2>
        <div class="flex items-center justify-between p-4 border border-error/20 rounded-lg bg-error-soft/30">
          <div>
            <p class="font-body-md-strong text-ink">Delete Account</p>
            <p class="font-body-sm text-body">Permanently delete your account and all data.</p>
          </div>
          <Button variant="secondary-sm" class="text-error border-error hover:bg-error-soft">Delete Account</Button>
        </div>
      </Card>
    </div>

    {/* Preferences Tab */}
    <div id="tab-preferences" class="settings-panel hidden space-y-6" role="tabpanel">
      <Card variant="marketing-large">
        <h2 class="font-display-md text-ink mb-6">AI Preferences</h2>
        <div class="space-y-6">
          <div>
            <label class="block font-body-sm-strong text-ink mb-1.5">Default Model</label>
            <select class="input h-10 w-full sm:w-auto">
              <option value="gemini-flash" selected>⚡ Gemini Flash (Fast)</option>
              <option value="gemini-pro">🧠 Gemini Pro (Best)</option>
              <option value="gemini-ultra">🚀 Gemini Ultra (Reasoning)</option>
            </select>
            <p class="font-caption text-mute mt-1">Used for new conversations. Can be changed per chat.</p>
          </div>

          <div>
            <label class="block font-body-sm-strong text-ink mb-1.5">Retrieval Settings</label>
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="font-body-sm text-body mb-1 block">Top K Results</label>
                <input type="number" value="10" min="1" max="50" class="input h-10 w-full" />
              </div>
              <div>
                <label class="font-body-sm text-body mb-1 block">Reranking</label>
                <select class="input h-10 w-full">
                  <option value="on" selected>Enabled</option>
                  <option value="off">Disabled</option>
                </select>
              </div>
            </div>
          </div>

          <div class="flex items-center justify-between p-4 bg-canvas-soft rounded-lg">
            <div>
              <p class="font-body-sm-strong text-ink">Citations</p>
              <p class="font-body-sm text-body">Show source citations in chat responses</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" checked class="sr-only peer" />
              <div class="w-11 h-6 bg-hairline peer-focus:ring-2 peer-focus:ring-link-bg-0 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
            </label>
          </div>

          <div class="flex items-center justify-between p-4 bg-canvas-soft rounded-lg">
            <div>
              <p class="font-body-sm-strong text-ink">Streaming Responses</p>
              <p class="font-body-sm text-body">Show AI responses as they are generated</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" checked class="sr-only peer" />
              <div class="w-11 h-6 bg-hairline peer-focus:ring-2 peer-focus:ring-link-bg-0 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
            </label>
          </div>
        </div>
      </Card>

      <Card variant="marketing-large">
        <h2 class="font-display-md text-ink mb-6">Notifications</h2>
        <div class="space-y-4">
          {[
            { label: 'Document processing complete', desc: 'When an upload finishes processing', checked: true },
            { label: 'Weekly study digest', desc: 'Summary of your learning activity', checked: true },
            { label: 'New connections found', desc: 'When AI discovers links between documents', checked: false },
            { label: 'Pro tips & updates', desc: 'Product announcements and features', checked: false },
          ].map((item) => (
            <div class="flex items-center justify-between p-4 bg-canvas-soft rounded-lg">
              <div>
                <p class="font-body-sm-strong text-ink">{item.label}</p>
                <p class="font-body-sm text-body">{item.desc}</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" checked={item.checked} class="sr-only peer" />
                <div class="w-11 h-6 bg-hairline peer-focus:ring-2 peer-focus:ring-link-bg-0 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
              </label>
            </div>
          ))}
        </div>
      </Card>
    </div>

    {/* Billing Tab */}
    <div id="tab-billing" class="settings-panel hidden space-y-6" role="tabpanel">
      <Card variant="marketing-large">
        <div class="flex items-center justify-between mb-6">
          <h2 class="font-display-md text-ink">Current Plan</h2>
          <Badge variant="secondary" size="sm">{user?.plan === 'pro' ? 'Pro' : user?.plan === 'team' ? 'Team' : 'Free Beta'}</Badge>
        </div>
        <div class="grid sm:grid-cols-3 gap-4 mb-6">
          <div class="text-center p-4 bg-canvas-soft rounded-lg">
            <p class="font-display-xl text-ink">50</p>
            <p class="font-body-sm text-mute">Documents</p>
            <p class="font-caption text-mute">0 used</p>
          </div>
          <div class="text-center p-4 bg-canvas-soft rounded-lg">
            <p class="font-display-xl text-ink">30</p>
            <p class="font-body-sm text-mute">Chats / day</p>
            <p class="font-caption text-mute">7 used</p>
          </div>
          <div class="text-center p-4 bg-canvas-soft rounded-lg">
            <p class="font-display-xl text-ink">2</p>
            <p class="font-body-sm text-mute">Audio / day</p>
            <p class="font-caption text-mute">1 used</p>
          </div>
        </div>
        <button onclick="showUpgradeModal()" class="btn-primary inline-flex">Upgrade to Pro</button>
      </Card>

      <Card variant="marketing-large">
        <h2 class="font-display-md text-ink mb-4">Payment Method</h2>
        <div class="p-4 bg-canvas-soft rounded-lg text-center">
          <p class="font-body-sm text-body">No payment method on file</p>
          <p class="font-caption text-mute mt-1">Add a payment method to upgrade to Pro</p>
        </div>
      </Card>

      <Card variant="marketing-large">
        <h2 class="font-display-md text-ink mb-4">Billing History</h2>
        <div class="p-4 bg-canvas-soft rounded-lg text-center">
          <p class="font-body-sm text-body">No billing history yet</p>
        </div>
      </Card>
    </div>

    {/* API Keys Tab */}
    <div id="tab-api" class="settings-panel hidden space-y-6" role="tabpanel">
      <Card variant="marketing-large">
        <div class="flex items-center justify-between mb-6">
          <h2 class="font-display-md text-ink">API Keys</h2>
          <Button variant="primary-sm" id="create-key-btn">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="mr-1" aria-hidden="true">
              <path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            Create Key
          </Button>
        </div>
        <p class="font-body-sm text-body mb-4">API keys give you programmatic access to your knowledge base.</p>

        <div class="space-y-3" id="api-keys-list">
          <div class="flex items-center justify-between p-4 bg-canvas-soft rounded-lg">
            <div class="min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <p class="font-body-sm-strong text-ink">Production Key</p>
                <Badge variant="success" size="sm">Active</Badge>
              </div>
              <p class="font-caption-mono text-mute text-xs">nca_live_••••••••••••••••k4f2</p>
              <p class="font-caption text-mute mt-1">Created Aug 15, 2026 · Last used 2 hours ago</p>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <button class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-canvas transition-colors text-mute hover:text-ink" aria-label="Copy key" title="Copy key">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <rect x="5" y="5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M3 11V3.5A1.5 1.5 0 0 1 4.5 2H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </button>
              <button class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-canvas transition-colors text-mute hover:text-error" aria-label="Revoke key">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M2 4h12M5.33 4V2.67a1.33 1.33 0 0 1 1.34-1.34h2.66a1.33 1.33 0 0 1 1.34 1.34V4M12.67 4v9.33a1.33 1.33 0 0 1-1.34 1.34H4.67a1.33 1.33 0 0 1-1.34-1.34V4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <div class="mt-4 p-4 bg-canvas-soft rounded-lg">
          <h3 class="font-body-sm-strong text-ink mb-2">API Access</h3>
          <p class="font-body-sm text-body mb-2">REST and GraphQL API access is coming soon for Pro and Enterprise plans.</p>
          <p class="font-caption text-mute">Join the waitlist to be notified when API access launches.</p>
        </div>
      </Card>
    </div>

    {/* Data & Export Tab */}
    <div id="tab-data" class="settings-panel hidden space-y-6" role="tabpanel">
      <Card variant="marketing-large">
        <h2 class="font-display-md text-ink mb-6">Export Data</h2>
        <p class="font-body-sm text-body mb-4">Export your knowledge base, conversations, and study sets.</p>
        <div class="grid sm:grid-cols-2 gap-3">
          {[
            { format: 'Markdown', ext: '.zip', desc: 'Documents + metadata as .md files' },
            { format: 'JSON', ext: '.json', desc: 'Full knowledge base with embeddings' },
            { format: 'CSV', ext: '.csv', desc: 'Document metadata and tags' },
            { format: 'Anki', ext: '.apkg', desc: 'Flashcards for Anki import' },
          ].map((item) => (
            <button class="flex items-center gap-3 p-4 bg-canvas-soft rounded-lg hover:bg-canvas-soft-2 transition-colors text-left group">
              <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0 group-hover:bg-primary/20 transition-colors">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="text-primary" aria-hidden="true">
                  <path d="M10 3v10M6 9l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="font-body-sm-strong text-ink">{item.format} <span class="font-caption text-mute">({item.ext})</span></p>
                <p class="font-caption text-mute">{item.desc}</p>
              </div>
            </button>
          ))}
        </div>
      </Card>

      <Card variant="marketing-large">
        <h2 class="font-display-md text-ink mb-4">Knowledge Base</h2>
        <div class="space-y-4">
          <div class="flex items-center justify-between p-4 bg-canvas-soft rounded-lg">
            <div>
              <p class="font-body-sm-strong text-ink">Re-index Documents</p>
              <p class="font-body-sm text-body">Rebuild search embeddings for all documents</p>
            </div>
            <Button variant="secondary-sm">Re-index</Button>
          </div>
          <div class="flex items-center justify-between p-4 bg-canvas-soft rounded-lg">
            <div>
              <p class="font-body-sm-strong text-ink">Clear Chat History</p>
              <p class="font-body-sm text-body">Delete all conversation history</p>
            </div>
            <Button variant="secondary-sm" class="text-error border-error hover:bg-error-soft">Clear</Button>
          </div>
        </div>
      </Card>
    </div>
  </div>

  <UpgradeModal />
</AppLayout>

<script>
  // Tab switching
  const tabs = document.querySelectorAll<HTMLElement>('.settings-tab');
  const panels = document.querySelectorAll<HTMLElement>('.settings-panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab;
      if (!target) return;

      // Update tab states
      tabs.forEach((t) => {
        t.classList.remove('text-ink', 'border-b-2', 'border-primary', 'font-body-sm-strong');
        t.classList.add('text-body', 'border-b-2', 'border-transparent');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('text-ink', 'border-b-2', 'border-primary', 'font-body-sm-strong');
      tab.classList.remove('text-body', 'border-b-2', 'border-transparent');
      tab.setAttribute('aria-selected', 'true');

      // Show/hide panels
      panels.forEach((p) => {
        p.classList.toggle('hidden', p.id !== `tab-${target}`);
      });
    });
  });
</script>

export const prerender = false;
---
import AppLayout from '../../../layouts/AppLayout.astro';
import Badge from '../../../components/ui/Badge.astro';
import Card from '../../../components/ui/Card.astro';
import UpgradeModal from '../../../components/ui/UpgradeModal.astro';
import { formatMonthly } from '../../../lib/pricing';

const user = (Astro.locals as any)?.user;
---

<AppLayout title="Billing — NotesChatAI">
  <div class="max-w-3xl mx-auto space-y-8">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <a href="/app/settings" class="font-body-sm text-mute hover:text-ink transition-colors">Settings</a>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="text-mute" aria-hidden="true">
          <path d="M5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="font-body-sm text-ink font-medium">Billing</span>
      </div>
      <h1 class="font-display-lg text-ink">Billing</h1>
      <p class="font-body-md text-body mt-1">Manage your subscription, payment method, and billing history.</p>
    </div>

    {/* In-page error banner (replaces native alert()) */}
    <div id="billing-error-banner" class="hidden mb-4 p-4 bg-error-soft rounded-lg border border-error/20 flex items-start justify-between gap-3" role="alert">
      <p id="billing-error-text" class="font-body-sm text-error flex items-start gap-2">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-shrink-0 mt-0.5" aria-hidden="true">
          <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
          <path d="M8 5v4M8 11h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span>An error occurred. Please try again.</span>
      </p>
      <button type="button" id="billing-error-close" class="text-error hover:text-error-deep font-body-sm-strong flex-shrink-0" aria-label="Dismiss error">Dismiss</button>
    </div>

    {/* Current Plan */}
    <Card variant="marketing-large">
      <div class="flex items-center justify-between mb-6">
        <h2 class="font-display-md text-ink">Current Plan</h2>
        <Badge variant="secondary" size="sm">{user?.plan === 'pro' ? 'Pro' : user?.plan === 'team' ? 'Team' : 'Free Beta'}</Badge>
      </div>
      <div class="grid sm:grid-cols-3 gap-4 mb-6">
        <div class="text-center p-4 bg-canvas-soft rounded-lg">
          <p class="font-display-xl text-ink">{user?.plan === 'plus' ? '∞' : user?.plan === 'pro' ? '500' : '50'}</p>
          <p class="font-body-sm text-mute">Documents</p>
        </div>
        <div class="text-center p-4 bg-canvas-soft rounded-lg">
          <p class="font-display-xl text-ink">{user?.plan === 'plus' ? '∞' : user?.plan === 'pro' ? '300' : '30'}</p>
          <p class="font-body-sm text-mute">Chats / day</p>
        </div>
        <div class="text-center p-4 bg-canvas-soft rounded-lg">
          <p class="font-display-xl text-ink">{user?.plan === 'plus' ? '100' : user?.plan === 'pro' ? '20' : '2'}</p>
          <p class="font-body-sm text-mute">Audio / day</p>
        </div>
      </div>
      {user?.plan === 'free' ? (
        <div class="flex gap-3">
          <button onclick="handleBillingUpgrade('pro')" class="btn-primary inline-flex">Upgrade to Pro — {formatMonthly('pro')}</button>
          <button onclick="handleBillingUpgrade('plus')" class="btn-secondary inline-flex">Upgrade to Plus — {formatMonthly('plus')}</button>
        </div>
      ) : user?.plan === 'pro' ? (
        <button onclick="handleBillingUpgrade('plus')" class="btn-primary inline-flex">Upgrade to Plus — {formatMonthly('plus')}</button>
      ) : null}
    </Card>

    {/* Payment Method */}
    <Card variant="marketing-large">
      <h2 class="font-display-md text-ink mb-4">Payment Method</h2>
      <div class="p-4 bg-canvas-soft rounded-lg text-center">
        <p class="font-body-sm text-body">No payment method on file</p>
        <p class="font-caption text-mute mt-1">Add a payment method to upgrade to Pro</p>
      </div>
    </Card>

    {/* Billing History */}
    <Card variant="marketing-large">
      <h2 class="font-display-md text-ink mb-4">Billing History</h2>
      <div class="p-4 bg-canvas-soft rounded-lg text-center">
        <p class="font-body-sm text-body">No billing history yet</p>
      </div>
    </Card>
  </div>
  <UpgradeModal />
</AppLayout>

<script>
  const errorBanner = document.getElementById('billing-error-banner') as HTMLElement | null;
  const errorText = document.getElementById('billing-error-text')?.querySelector('span') as HTMLElement | null;
  const errorClose = document.getElementById('billing-error-close');

  function showBillingError(message: string) {
    if (!errorBanner || !errorText) { alert(message); return; }
    errorText.textContent = message;
    errorBanner.classList.remove('hidden');
  }

  errorClose?.addEventListener('click', () => {
    errorBanner?.classList.add('hidden');
  });

  async function handleBillingUpgrade(plan: string) {
    try {
      const res = await fetch('/api/billing/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ plan }),
      });
      const data = await res.json();
      if (res.ok && data.url) {
        window.location.href = data.url;
      } else {
        showBillingError(data.error || 'Failed to start checkout. Please try again.');
      }
    } catch {
      showBillingError('Network error. Please try again.');
    }
  }
  (window as any).handleBillingUpgrade = handleBillingUpgrade;
</script>

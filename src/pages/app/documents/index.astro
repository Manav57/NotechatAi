---
import AppLayout from '../../../layouts/AppLayout.astro';
import Button from '../../../components/ui/Button.astro';
import Input from '../../../components/ui/Input.astro';
import Badge from '../../../components/ui/Badge.astro';
import Card from '../../../components/ui/Card.astro';
---

<AppLayout title="Documents — NotesChatAI" user={{ name: 'Demo User', email: 'demo@noteschatai.com', plan: 'free' }}>
  <div class="space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="font-display-lg text-ink">Documents</h1>
        <p class="font-body-md text-body mt-1">Manage your knowledge base. Upload PDFs, EPUBs, YouTube links, and more.</p>
      </div>
      <Button variant="primary" id="upload-btn">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="mr-2" aria-hidden="true">
          <path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        Upload Document
      </Button>
    </div>

    <div class="bg-canvas rounded-lg border border-hairline overflow-hidden">
      <div class="p-4 border-b border-hairline">
        <div class="flex flex-col sm:flex-row gap-4">
          <Input
            id="search-input"
            placeholder="Search documents..."
            size="md"
            class="flex-1"
          />
          <select id="type-filter" class="input h-10 w-full sm:w-auto">
            <option value="">All Types</option>
            <option value="pdf">PDF</option>
            <option value="epub">EPUB</option>
            <option value="youtube">YouTube</option>
            <option value="web">Web Page</option>
            <option value="audio">Audio</option>
          </select>
          <select id="status-filter" class="input h-10 w-full sm:w-auto">
            <option value="">All Status</option>
            <option value="ready">Ready</option>
            <option value="processing">Processing</option>
            <option value="error">Error</option>
          </select>
        </div>
      </div>

      <div class="divide-y divide-hairline">
        {[
          { id: '1', title: 'Machine Learning Fundamentals.pdf', type: 'pdf', status: 'ready', pages: 142, size: '8.2 MB', uploaded: '2 hours ago', chunks: 284 },
          { id: '2', title: 'Neural Networks Overview (YouTube)', type: 'youtube', status: 'processing', duration: '45:23', uploaded: '3 hours ago' },
          { id: '3', title: 'Attention Is All You Need.pdf', type: 'pdf', status: 'ready', pages: 15, size: '2.1 MB', uploaded: '1 day ago', chunks: 42 },
          { id: '4', title: 'Deep Learning Book - Chapter 6.epub', type: 'epub', status: 'ready', pages: 34, size: '4.7 MB', uploaded: '2 days ago', chunks: 89 },
          { id: '5', title: 'Transformer Architecture Explained (Web)', type: 'web', status: 'ready', size: '1.2 MB', uploaded: '3 days ago', chunks: 56 },
          { id: '6', title: 'RNN vs LSTM Comparison.pdf', type: 'pdf', status: 'error', pages: 8, size: '1.5 MB', uploaded: '4 days ago', error: 'Failed to extract text from scanned pages' },
        ].map((doc) => (
          <div class="p-4 hover:bg-canvas-soft/50 transition-colors flex flex-col sm:flex-row sm:items-center gap-4">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-3 flex-wrap">
                <h3 class="font-body-md text-ink truncate">{doc.title}</h3>
                <Badge variant="secondary" size="sm">{doc.type.toUpperCase()}</Badge>
                <Badge variant={doc.status === 'ready' ? 'success' : doc.status === 'processing' ? 'warning' : 'error'} size="sm">
                  {doc.status.charAt(0).toUpperCase() + doc.status.slice(1)}
                </Badge>
              </div>
              <div class="flex flex-wrap gap-4 mt-2 font-body-sm text-mute">
                {doc.pages && <span>{doc.pages} pages</span>}
                {doc.size && <span>{doc.size}</span>}
                {doc.duration && <span>{doc.duration}</span>}
                {doc.chunks && <span>{doc.chunks} chunks</span>}
                <span>{doc.uploaded}</span>
              </div>
              {doc.error && <p class="font-body-sm text-error mt-2">{doc.error}</p>}
            </div>
            <div class="flex items-center gap-2 sm:ml-auto">
              {doc.status === 'ready' && (
                <>
                  <a href={`/app/documents/${doc.id}`} class="btn-secondary-sm">View</a>
                  <Button variant="ghost" size="sm" aria-label="More options">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                      <circle cx="9" cy="9" r="1.5" fill="currentColor"/>
                    </svg>
                  </Button>
                </>
              )}
              {doc.status === 'error' && (
                <Button variant="secondary-sm" class="text-error border-error hover:bg-error-soft">Retry</Button>
              )}
              {doc.status === 'processing' && (
                <Badge variant="warning" size="sm">Processing...</Badge>
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="p-4 border-t border-hairline flex items-center justify-between">
        <p class="font-body-sm text-mute">Showing 6 of 24 documents</p>
        <div class="flex gap-2">
          <Button variant="secondary-sm" disabled>Previous</Button>
          <Button variant="secondary-sm">Next</Button>
        </div>
      </div>
    </div>
  </div>

  <!-- Upload Modal -->
  <div id="upload-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
    <div class="bg-canvas rounded-lg shadow-level-5 w-full max-w-md max-h-[90vh] overflow-y-auto">
      <div class="p-6 border-b border-hairline flex items-center justify-between">
        <h2 class="font-display-md text-ink">Upload Document</h2>
        <button id="close-modal" class="text-mute hover:text-ink transition-colors" aria-label="Close">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      <form id="upload-form" class="p-6 space-y-5">
        <div>
          <label class="block font-body-sm-strong text-ink mb-2">Upload File or Enter URL</label>
          <div class="border-2 border-dashed border-hairline rounded-lg p-8 text-center hover:border-primary hover:bg-canvas-soft transition-colors" id="drop-zone">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" class="mx-auto mb-3 text-mute" aria-hidden="true">
              <path d="M24 8v24M8 24h24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <p class="font-body-md text-body mb-1">Drag & drop a file here, or click to browse</p>
            <p class="font-body-sm text-mute">PDF, EPUB, TXT, MDX, MP3, WAV (max 100MB)</p>
            <input type="file" id="file-input" class="hidden" accept=".pdf,.epub,.txt,.mdx,.mp3,.wav" />
          </div>
        </div>
        <div>
          <label class="block font-body-sm-strong text-ink mb-2">Or enter a URL</label>
          <Input
            id="url-input"
            placeholder="https://youtube.com/watch?v=... or https://example.com/article"
            helperText="Supports YouTube, web pages, and direct file links"
          />
        </div>
        <div class="flex gap-3 pt-4">
          <Button type="button" variant="secondary" id="cancel-upload" class="flex-1">Cancel</Button>
          <Button type="submit" variant="primary" class="flex-1" id="submit-upload">Upload & Process</Button>
        </div>
      </form>
    </div>
  </div>
</AppLayout>

<script type="module">
  import { DocumentsClient } from '../../../components/DocumentsClient/DocumentsClient.tsx';
</script>
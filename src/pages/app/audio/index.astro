---
import AppLayout from '../../../layouts/AppLayout.astro';
import Button from '../../../components/ui/Button.astro';
import Card from '../../../components/ui/Card.astro';
import Badge from '../../../components/ui/Badge.astro';
import Input from '../../../components/ui/Input.astro';
---

<AppLayout title="Audio Overviews — NotesChatAI" user={{ name: 'Demo User', email: 'demo@noteschatai.com', plan: 'free' }}>
  <div class="space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="font-display-lg text-ink">Audio Overviews</h1>
        <p class="font-body-md text-body mt-1">Generate podcast-style summaries with transcripts, chapters, and a saved library.</p>
      </div>
      <Button variant="primary" id="generate-btn">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="mr-2" aria-hidden="true">
          <circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="2"/>
          <polygon points="7,6 12,9 7,12" fill="currentColor"/>
        </svg>
        Generate Overview
      </Button>
    </div>

    <div class="grid lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 space-y-6">
        <Card variant="marketing-large">
          <h2 class="font-display-md text-ink mb-6">Your Library</h2>
          <div class="space-y-4" id="audio-library">
            {[
              { id: '1', title: 'Attention Mechanisms Explained', documents: ['Attention Is All You Need.pdf'], status: 'ready', duration: '12:34', created: '2 hours ago', chapters: 5 },
              { id: '2', title: 'Transformer vs RNN Comparison', documents: ['Transformer Architecture.pdf', 'RNN vs LSTM.pdf'], status: 'ready', duration: '18:22', created: '1 day ago', chapters: 8 },
              { id: '3', title: 'Neural Networks Fundamentals', documents: ['Deep Learning Book Ch6.epub'], status: 'generating', created: '5 minutes ago' },
            ].map((audio) => (
              <div class="p-4 bg-canvas-soft/50 rounded-lg hover:bg-canvas-soft transition-colors">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap mb-2">
                      <h3 class="font-display-sm text-ink truncate">{audio.title}</h3>
                      <Badge variant={audio.status === 'ready' ? 'success' : 'warning'} size="sm">
                        {audio.status === 'ready' ? 'Ready' : 'Generating...'}
                      </Badge>
                    </div>
                    <div class="flex flex-wrap gap-4 font-body-sm text-mute mb-2">
                      <span>{audio.duration ? `⏱ ${audio.duration}` : '⏳ Generating...'}</span>
                      <span>📑 {audio.chapters ? `${audio.chapters} chapters` : '—'}</span>
                      <span>🕐 {audio.created}</span>
                    </div>
                    <div class="flex flex-wrap gap-2">
                      {audio.documents.map((doc) => (
                        <Badge variant="secondary" size="sm" key={doc}>{doc}</Badge>
                      ))}
                    </div>
                  </div>
                  <div class="flex items-center gap-2 sm:ml-auto">
                    {audio.status === 'ready' && (
                      <>
                        <Button variant="ghost" size="sm" aria-label="Play">
                          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                            <circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="1.5"/>
                            <polygon points="7,6 12,9 7,12" fill="currentColor"/>
                          </svg>
                        </Button>
                        <Button variant="secondary-sm">Open</Button>
                      </>
                    )}
                    {audio.status === 'generating' && (
                      <div class="flex items-center gap-2 text-mute font-body-sm">
                        <svg class="animate-spin" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                          <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" stroke-dasharray="31.4" stroke-dashoffset="10" stroke-linecap="round"/>
                        </svg>
                        Generating...
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
          <div class="text-center pt-4 border-t border-hairline">
            <Button variant="secondary">Load More</Button>
          </div>
        </Card>
      </div>

      <div class="space-y-6">
        <Card variant="marketing-large">
          <h2 class="font-display-md text-ink mb-6">Generate New Overview</h2>
          <form id="generate-form" class="space-y-5">
            <div>
              <label class="block font-body-sm-strong text-ink mb-2">Select Documents</label>
              <div class="border border-hairline rounded-lg p-4 max-h-48 overflow-y-auto" id="doc-selector">
                {[
                  { id: '1', title: 'Attention Is All You Need.pdf', chunks: 42 },
                  { id: '2', title: 'Transformer Architecture.pdf', chunks: 56 },
                  { id: '3', title: 'RNN vs LSTM Comparison.pdf', chunks: 28 },
                  { id: '4', title: 'Deep Learning Book - Chapter 6.epub', chunks: 89 },
                ].map((doc) => (
                  <label class="flex items-center gap-3 p-2 hover:bg-canvas-soft rounded-lg cursor-pointer transition-colors">
                    <input type="checkbox" name="documents" value={doc.id} class="w-4 h-4 rounded border-hairline text-primary focus:ring-2 focus:ring-link-bg-soft" />
                    <div class="flex-1 min-w-0">
                      <p class="font-body-sm text-ink truncate">{doc.title}</p>
                      <p class="font-caption-mono text-mute">{doc.chunks} chunks</p>
                    </div>
                  </label>
                ))}
              </div>
              <p class="font-body-sm text-mute mt-2">Select up to 10 documents</p>
            </div>

            <div>
              <label class="block font-body-sm-strong text-ink mb-2">Title (optional)</label>
              <Input
                placeholder="Audio Overview: Attention Mechanisms"
                helperText="Auto-generated from document titles if left empty"
              />
            </div>

            <div>
              <label class="block font-body-sm-strong text-ink mb-2">Voice Settings</label>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block font-body-sm text-body mb-1">Voice</label>
                  <select class="input h-10">
                    <option value="nova">Nova (Default)</option>
                    <option value="alloy">Alloy</option>
                    <option value="echo">Echo</option>
                    <option value="fable">Fable</option>
                    <option value="onyx">Onyx</option>
                    <option value="shimmer">Shimmer</option>
                  </select>
                </div>
                <div>
                  <label class="block font-body-sm text-body mb-1">Speed</label>
                  <select class="input h-10">
                    <option value="0.75">0.75x</option>
                    <option value="1.0" selected>1.0x (Normal)</option>
                    <option value="1.25">1.25x</option>
                    <option value="1.5">1.5x</option>
                    <option value="2.0">2.0x</option>
                  </select>
                </div>
              </div>
            </div>

            <Button type="submit" variant="primary" class="w-full" id="submit-generate">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="mr-2" aria-hidden="true">
                <circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="2"/>
                <polygon points="7,6 12,9 7,12" fill="currentColor"/>
              </svg>
              Generate Audio Overview
            </Button>
          </form>
        </Card>

        <Card variant="marketing">
          <h3 class="font-display-sm text-ink mb-4">How It Works</h3>
          <ul class="space-y-3" role="list">
            {[
              'AI analyzes your selected documents',
              'Two-host script generated with natural dialogue',
              'High-quality TTS creates the audio',
              'Transcript with word-level timestamps',
              'Auto-chaptered by topic',
              'Saved to your library forever',
            ].map((step) => (
              <li class="flex items-center gap-3 font-body-sm text-body">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-cyan flex-shrink-0" aria-hidden="true">
                  <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="2"/>
                  <path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {step}
              </li>
            ))}
          </ul>
        </Card>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  // Form handling
  const generateForm = document.getElementById('generate-form');
  const generateBtn = document.getElementById('generate-btn');
  const submitGenerate = document.getElementById('submit-generate');

  generateForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(generateForm);
    const documents = formData.getAll('documents');
    
    if (documents.length === 0) {
      alert('Please select at least one document');
      return;
    }

    submitGenerate!.disabled = true;
    submitGenerate!.innerHTML = `
      <svg class="animate-spin mr-2" width="18" height="18" viewBox="0 0 18 18" fill="none">
        <circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="2" stroke-dasharray="31.4" stroke-dashoffset="10" stroke-linecap="round"/>
      </svg>
      Generating...
    `;

    try {
      // Simulate API call
      await new Promise(r => setTimeout(r, 2000));
      alert('Audio overview generation started! Check your library in a moment.');
      window.location.reload();
    } catch (error) {
      alert('Failed to start generation. Please try again.');
    } finally {
      submitGenerate!.disabled = false;
      submitGenerate!.innerHTML = `
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="mr-2">
          <circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="2"/>
          <polygon points="7,6 12,9 7,12" fill="currentColor"/>
        </svg>
        Generate Audio Overview
      `;
    }
  });
</script>
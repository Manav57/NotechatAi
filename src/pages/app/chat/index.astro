export const prerender = false;
---
import AppLayout from '../../../layouts/AppLayout.astro';
---

<AppLayout title="Chat — NotesChatAI">
  <div class="h-[calc(100vh-64px)] flex -my-8 -mx-4 lg:-mx-8 bg-canvas overflow-x-hidden">
    {/* ═══════════ Sidebar ═══════════ */}
    <aside id="chat-sidebar" class="hidden lg:flex w-80 bg-canvas border-r border-hairline flex-col flex-shrink-0 transition-all duration-200">
      {/* New Chat / Add Document */}
      <div class="p-3 border-b border-hairline space-y-2">
        <button id="new-chat-btn" class="w-full h-10 rounded-xl bg-primary text-on-primary font-body-md-strong hover:opacity-90 active:opacity-70 transition-all flex items-center justify-center gap-2">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2.5v11M2.5 8h11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          New Chat
        </button>
        <a href="/app/documents" class="w-full h-10 rounded-xl border border-hairline bg-canvas text-ink font-body-md-strong hover:bg-canvas-soft active:bg-canvas-soft-2 transition-all flex items-center justify-center gap-2">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          Add Document
        </a>
      </div>

      <div class="px-4 pt-4 pb-2">
        <p class="font-caption-mono text-mute uppercase tracking-wider text-xs">Conversations</p>
      </div>
      <div class="flex-1 overflow-y-auto px-2 pb-3" id="conversation-list">
        <div class="p-4 text-center">
          <p class="font-body-sm text-mute">No conversations yet</p>
        </div>
      </div>
    </aside>

    {/* Mobile sidebar backdrop */}
    <div id="sidebar-backdrop" class="hidden fixed inset-0 z-40 bg-black/40 backdrop-blur-sm lg:hidden" aria-hidden="true"></div>

    {/* ═══════════ Main column ═══════════ */}
    <main class="flex-1 flex flex-col min-w-0 bg-canvas">
      {/* Header */}
      <header class="border-b border-hairline px-4 lg:px-6 py-3 flex items-center gap-3 flex-shrink-0">
        <button id="mobile-sidebar-toggle" class="lg:hidden w-9 h-9 flex items-center justify-center rounded-xl hover:bg-canvas-soft transition-colors text-body" aria-label="Open conversations">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M3 5.5h14M3 10h14M3 14.5h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
        <div class="min-w-0">
          <h1 class="font-display-sm text-ink truncate" id="chat-title">New Conversation</h1>
          <p class="font-caption text-mute truncate">Ask anything about your documents — answers come with citations</p>
        </div>
      </header>

      {/* In-page error banner (Task M) */}
      <div id="chat-error-banner" class="hidden mx-4 lg:mx-8 mt-3 p-3 bg-error-soft rounded-lg border border-error/20 flex items-start justify-between gap-3" role="alert">
        <p class="font-body-sm text-error flex items-start gap-2">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-shrink-0 mt-0.5" aria-hidden="true">
            <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
            <path d="M8 5v4M8 11h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span id="chat-error-text">Something went wrong. Please try again.</span>
        </p>
        <button type="button" id="chat-error-close" class="text-error hover:text-error-deep font-body-sm-strong flex-shrink-0" aria-label="Dismiss error">Dismiss</button>
      </div>

      {/* Messages area */}
      <div class="flex-1 overflow-y-auto" id="messages-container">
        <div class="max-w-3xl mx-auto px-4 lg:px-6 py-6">
          {/* Welcome state */}
          <div id="welcome-state" class="min-h-[50vh] flex flex-col items-center justify-center text-center">
            <div class="w-14 h-14 rounded-2xl bg-primary flex items-center justify-center mb-6">
              <svg width="28" height="28" viewBox="0 0 32 32" fill="none" class="text-on-primary" aria-hidden="true">
                <rect x="4" y="6" width="24" height="18" rx="4" stroke="currentColor" stroke-width="2"/>
                <path d="M10 12h8M10 16h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <path d="M12 24l-3 4h8l-3-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h2 class="font-display-lg text-ink mb-2">What would you like to know?</h2>
            <p class="font-body-md text-body max-w-md mb-8">Ask about your documents, generate study guides, or just have a conversation. Upload documents to get grounded, cited answers.</p>
            <div class="grid sm:grid-cols-2 gap-3 max-w-lg w-full">
              {['Summarize my ML notes', 'Explain attention mechanism', 'Quiz me on my flashcards', 'Generate a study guide'].map((s) => (
                <button class="suggestion-btn text-left p-3.5 bg-canvas-soft rounded-xl border border-hairline hover:border-hairline-strong hover:bg-canvas-soft-2 transition-all group" data-suggestion={s}>
                  <span class="font-body-sm text-ink group-hover:text-primary transition-colors">{s}</span>
                </button>
              ))}
            </div>
          </div>

          {/* Messages */}
          <div id="messages-list" class="hidden space-y-6"></div>
        </div>
      </div>

      {/* Composer */}
      <div class="px-4 lg:px-8 pb-5 pt-1 flex-shrink-0">
        <div class="max-w-3xl mx-auto">
          <form id="chat-form">
            <div class="flex items-end gap-2 bg-canvas-soft rounded-2xl border border-hairline hover:border-hairline-strong focus-within:border-hairline-strong focus-within:shadow-level-2 transition-all px-2 py-2">
              <textarea id="chat-input" placeholder="Ask anything about your documents..." class="flex-1 bg-transparent font-body-md text-ink placeholder:text-mute resize-none py-2 pl-3 pr-2 focus:outline-none min-h-[44px] max-h-48 leading-relaxed" rows="1" aria-label="Message" style="field-sizing: content;"></textarea>
              <button type="submit" id="send-btn" class="w-9 h-9 flex items-center justify-center rounded-xl bg-primary text-on-primary hover:opacity-90 active:opacity-70 transition-all disabled:opacity-30 disabled:cursor-not-allowed flex-shrink-0" disabled aria-label="Send message">
                <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                  <path d="M16 9L3 3l2.5 6L3 15l13-6z" fill="currentColor"/>
                </svg>
              </button>
            </div>
            <div class="flex items-center justify-between mt-2 px-1">
              <a href="/app/documents" class="font-caption text-mute hover:text-ink transition-colors inline-flex items-center gap-1.5">
                <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M7 3v8M3 7h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                Add a document for better answers
              </a>
              <p class="font-caption text-mute hidden sm:block"><kbd class="px-1.5 py-0.5 bg-canvas-soft-2 rounded text-mute font-mono text-[11px]">Enter</kbd> to send · <kbd class="px-1.5 py-0.5 bg-canvas-soft-2 rounded text-mute font-mono text-[11px]">Shift+Enter</kbd> new line</p>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <script>
    const chatForm = document.getElementById('chat-form') as HTMLFormElement;
    const chatInput = document.getElementById('chat-input') as HTMLTextAreaElement;
    const messagesContainer = document.getElementById('messages-container');
    const welcomeState = document.getElementById('welcome-state');
    const messagesList = document.getElementById('messages-list');
    const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
    const newChatBtn = document.getElementById('new-chat-btn');
    const chatTitle = document.getElementById('chat-title');
    const mobileSidebarToggle = document.getElementById('mobile-sidebar-toggle');
    const chatSidebar = document.getElementById('chat-sidebar');
    const sidebarBackdrop = document.getElementById('sidebar-backdrop');
    const convList = document.getElementById('conversation-list');
    const errorBanner = document.getElementById('chat-error-banner');
    const errorText = document.getElementById('chat-error-text');
    const errorClose = document.getElementById('chat-error-close');

    let currentConversationId: string | null = null;
    let isStreaming = false;

    // ─── Error banner (in-page, dismissible) ───
    function showChatError(message: string) {
      if (!errorBanner || !errorText) return;
      errorText.textContent = message || 'Something went wrong. Please try again.';
      errorBanner.classList.remove('hidden');
    }
    errorClose?.addEventListener('click', () => errorBanner?.classList.add('hidden'));

    // Auto-resize textarea (CSS field-sizing when supported, manual fallback)
    const supportsFieldSizing = CSS.supports('field-sizing', 'content');
    chatInput?.addEventListener('input', function () {
      if (!supportsFieldSizing) {
        this.style.height = 'auto';
        this.style.height = Math.min(this.scrollHeight, 192) + 'px';
      }
      if (sendBtn) sendBtn.disabled = !this.value.trim() || isStreaming;
    });

    document.querySelectorAll('.suggestion-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const s = (btn as HTMLElement).dataset.suggestion;
        if (s && chatInput) { chatInput.value = s; chatInput.dispatchEvent(new Event('input')); chatInput.focus(); }
      });
    });

    newChatBtn?.addEventListener('click', () => { if (window.innerWidth < 1024) closeSidebar(); currentConversationId = null; resetChat(); });

    // ─── Mobile sidebar drawer ───
    mobileSidebarToggle?.addEventListener('click', openSidebar);

    function openSidebar() {
      if (!chatSidebar) return;
      chatSidebar.classList.add('flex');
      ['absolute', 'inset-y-0', 'left-0', 'z-50', 'shadow-level-5'].forEach(c => chatSidebar.classList.add(c));
      sidebarBackdrop?.classList.remove('hidden');
    }
    function closeSidebar() {
      if (!chatSidebar) return;
      chatSidebar.classList.remove('flex');
      ['absolute', 'inset-y-0', 'left-0', 'z-50', 'shadow-level-5'].forEach(c => chatSidebar.classList.remove(c));
      sidebarBackdrop?.classList.add('hidden');
    }
    sidebarBackdrop?.addEventListener('click', closeSidebar);

    function resetChat() {
      welcomeState?.classList.remove('hidden');
      messagesList?.classList.add('hidden');
      if (messagesList) messagesList.innerHTML = '';
      if (chatTitle) chatTitle.textContent = 'New Conversation';
      errorBanner?.classList.add('hidden');
    }

    function scrollToBottom() { if (messagesContainer) messagesContainer.scrollTop = messagesContainer.scrollHeight; }

    function escapeHtml(text: string) { const d = document.createElement('div'); d.textContent = text; return d.innerHTML.replace(/\n/g, '<br>'); }

    // Simple markdown renderer for chat messages
    function renderMarkdown(text: string): string {
      let html = escapeHtml(text);
      // Code blocks
      html = html.replace(/```(\w+)?\n([\s\S]*?)```/g, '<pre class="bg-canvas-soft border border-hairline rounded-lg p-3 my-2 overflow-x-auto"><code class="font-mono text-sm">$2</code></pre>');
      // Inline code
      html = html.replace(/`([^`]+)`/g, '<code class="bg-canvas-soft-2 px-1.5 py-0.5 rounded text-sm font-mono">$1</code>');
      // Bold
      html = html.replace(/\*\*(.+?)\*\*/g, '<strong class="font-body-md-strong">$1</strong>');
      // Italic
      html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
      // Headers
      html = html.replace(/^### (.+)$/gm, '<h4 class="font-display-sm text-ink mt-3 mb-1">$1</h4>');
      html = html.replace(/^## (.+)$/gm, '<h3 class="font-display-md text-ink mt-4 mb-2">$1</h3>');
      html = html.replace(/^# (.+)$/gm, '<h2 class="font-display-lg text-ink mt-4 mb-2">$1</h2>');
      // Lists
      html = html.replace(/^[-*] (.+)$/gm, '<li class="ml-4">$1</li>');
      // Line breaks
      html = html.replace(/\n/g, '<br>');
      return html;
    }

    function addMessage(role: 'user' | 'assistant', content: string, citations?: any[], generatedFile?: { filename: string; downloadUrl: string; size: number }) {
      if (!messagesList) return;
      const div = document.createElement('div');
      div.className = 'message flex gap-3 animate-slide-up';
      const avatar = role === 'user'
        ? '<div class="w-8 h-8 rounded-full bg-canvas-soft-2 border border-hairline flex items-center justify-center text-ink text-sm font-medium flex-shrink-0" aria-hidden="true">U</div>'
        : '<div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-on-primary text-sm font-medium flex-shrink-0" aria-hidden="true">N</div>';
      const citationsHtml = citations?.length
        ? `<div class="flex flex-wrap gap-1.5 mt-3">${citations.map((c: any) => `<span class="inline-flex items-center gap-1 px-2 py-1 bg-violet/10 text-violet-deep rounded-full text-xs">📄 ${escapeHtml(c.title || 'Source')}</span>`).join('')}</div>` : '';
      const fileHtml = generatedFile
        ? (() => {
            const isDocx = generatedFile.filename.endsWith('.docx');
            const isXlsx = generatedFile.filename.endsWith('.xlsx');
            const badgeBg = isXlsx ? 'bg-success/10' : isDocx ? 'bg-link/10' : 'bg-error/10';
            const badgeText = isXlsx ? 'text-success' : isDocx ? 'text-link' : 'text-error';
            const badgeLabel = isXlsx ? 'XLSX' : isDocx ? 'DOCX' : 'PDF';
            return `<div class="mt-3 p-3 bg-canvas-soft border border-hairline rounded-lg flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg ${badgeBg} flex items-center justify-center flex-shrink-0">
              <span class="font-caption-mono text-xs font-medium ${badgeText}">${badgeLabel}</span>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-body-sm-strong text-ink truncate">${escapeHtml(generatedFile.filename)}</p>
              <p class="font-caption text-mute">${(generatedFile.size / 1024).toFixed(1)} KB</p>
            </div>
            <a href="${generatedFile.downloadUrl}" target="_blank" rel="noopener" class="btn-primary-sm text-xs inline-flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 2v8M4 7l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 10v1.5a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              Download
            </a>
          </div>`;
          })()
        : '';
      const renderedContent = role === 'assistant' ? renderMarkdown(content) : escapeHtml(content).replace(/\n/g, '<br>');
      div.innerHTML = `${avatar}<div class="flex-1 min-w-0"><div class="flex items-center gap-2 mb-1"><span class="font-body-sm-strong ${role === 'user' ? 'text-ink' : 'text-primary'}">${role === 'user' ? 'You' : 'NotesChatAI'}</span><span class="font-caption text-mute">Just now</span></div><div class="font-body-md text-ink/90 leading-relaxed">${renderedContent}</div>${fileHtml}${citationsHtml}</div>`;
      messagesList.appendChild(div);
      scrollToBottom();
    }

    function addTypingIndicator(): string {
      const id = 'typing-' + Date.now();
      const div = document.createElement('div');
      div.id = id;
      div.className = 'message flex gap-3 animate-slide-up';
      div.innerHTML = `<div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-on-primary text-sm font-medium flex-shrink-0" aria-hidden="true">N</div><div class="flex-1"><div class="flex items-center gap-2 mb-1"><span class="font-body-sm-strong text-primary">NotesChatAI</span><span class="font-caption text-mute">Thinking…</span></div><div class="flex gap-1.5 py-2"><span class="w-2 h-2 bg-primary/30 rounded-full animate-bounce" style="animation-delay:0ms"></span><span class="w-2 h-2 bg-primary/30 rounded-full animate-bounce" style="animation-delay:150ms"></span><span class="w-2 h-2 bg-primary/30 rounded-full animate-bounce" style="animation-delay:300ms"></span></div></div>`;
      messagesList?.appendChild(div);
      scrollToBottom();
      return id;
    }

    chatForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const message = chatInput?.value?.trim();
      if (!message || isStreaming) return;

      welcomeState?.classList.add('hidden');
      messagesList?.classList.remove('hidden');
      errorBanner?.classList.add('hidden');
      addMessage('user', message);
      chatInput.value = '';
      chatInput.style.height = 'auto';
      sendBtn.disabled = true;
      isStreaming = true;

      const typingId = addTypingIndicator();

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ message, conversationId: currentConversationId }),
        });

        document.getElementById(typingId)?.remove();

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          if (res.status === 429 && errData.error === 'QUOTA_EXCEEDED') {
            (window as any).showQuotaModal?.(errData.feature, errData.plan, errData.used, errData.limit);
            if (sendBtn) sendBtn.disabled = true;
            isStreaming = false;
            return;
          }
          throw new Error(errData.error || 'Chat failed');
        }

        const data = await res.json();

        if (data.conversationId) {
          currentConversationId = data.conversationId;
          if (chatTitle) chatTitle.textContent = message.slice(0, 50);
          loadConversations();
        }

        addMessage('assistant', data.message || 'No response generated.', data.citations, data.generatedFile);
      } catch (err) {
        document.getElementById(typingId)?.remove();
        const errorMsg = err instanceof Error ? err.message : 'Something went wrong. Please try again.';
        showChatError(errorMsg);
        // Add retry button in the messages area
        if (messagesList) {
          const retryDiv = document.createElement('div');
          retryDiv.className = 'flex gap-3 animate-slide-up';
          retryDiv.innerHTML = `<div class="w-8 h-8 rounded-full bg-error/10 flex items-center justify-center text-error text-sm font-medium flex-shrink-0">!</div><div class="flex-1"><div class="flex items-center gap-2 mb-1"><span class="font-body-sm-strong text-error">Error</span></div><p class="font-body-sm text-error/80 mb-2">${escapeHtml(errorMsg)}</p><button class="retry-btn btn-secondary-sm text-xs inline-flex items-center gap-1.5" data-retry-message="${escapeHtml(message)}"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7a6 6 0 1 1 1.5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M1 3v4h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Retry</button></div>`;
          messagesList.appendChild(retryDiv);
          scrollToBottom();
          // Attach retry handler
          retryDiv.querySelector('.retry-btn')?.addEventListener('click', () => {
            const retryMsg = (retryDiv.querySelector('.retry-btn') as HTMLElement)?.dataset.retryMessage;
            if (retryMsg && chatInput) {
              chatInput.value = retryMsg;
              chatInput.dispatchEvent(new Event('input'));
              retryDiv.remove();
              chatForm?.dispatchEvent(new Event('submit'));
            }
          });
        }
      } finally {
        isStreaming = false;
        if (sendBtn) sendBtn.disabled = !chatInput?.value?.trim();
      }
    });

    function timeAgo(iso: string): string {
      const t = new Date(iso).getTime();
      if (isNaN(t)) return '';
      const diff = Date.now() - t;
      const m = Math.floor(diff / 60000);
      if (m < 1) return 'just now';
      if (m < 60) return m + 'm ago';
      const h = Math.floor(m / 60);
      if (h < 24) return h + 'h ago';
      const d = Math.floor(h / 24);
      if (d < 7) return d + 'd ago';
      return new Date(iso).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
    }

    async function loadConversations() {
      try {
        const res = await fetch('/api/chat', { credentials: 'include' });
        const data = await res.json();
        const convs = data.conversations || [];
        if (!convList) return;

        if (convs.length === 0) {
          convList.innerHTML = '<div class="p-4 text-center"><p class="font-body-sm text-mute">No conversations yet</p></div>';
          return;
        }

        convList.innerHTML = convs.map((c: any) => `
          <a href="/app/chat" class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-canvas-soft transition-colors ${c.id === currentConversationId ? 'bg-canvas-soft border border-hairline' : 'border border-transparent'}" onclick="event.preventDefault(); loadConversation('${c.id}', '${escapeHtml(c.title).replace(/'/g, "\\'")}')">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-shrink-0 text-mute" aria-hidden="true"><path d="M3 2h8l2 2v10H3V2z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
            <span class="flex-1 min-w-0">
              <span class="block font-body-sm text-ink truncate">${escapeHtml(c.title || 'Untitled')}</span>
              <span class="block font-caption text-mute">${timeAgo(c.updatedAt)}</span>
            </span>
          </a>
        `).join('');
      } catch {}
    }

    (window as any).loadConversation = async (id: string, title: string) => {
      currentConversationId = id;
      if (chatTitle) chatTitle.textContent = title;
      welcomeState?.classList.add('hidden');
      messagesList?.classList.remove('hidden');
      errorBanner?.classList.add('hidden');
      if (messagesList) messagesList.innerHTML = '';

      try {
        const res = await fetch(`/api/chat/${id}`, { credentials: 'include' });
        const data = await res.json();
        (data.messages || []).forEach((m: any) => {
          if (m.role === 'user' || m.role === 'assistant') {
            addMessage(m.role, m.content, m.citations ? JSON.parse(m.citations) : undefined);
          }
        });
      } catch {
        showChatError('Could not load this conversation. Please try again.');
      }
      loadConversations();
    };

    loadConversations();
  </script>

  <style>
    @keyframes bounce { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }
    .animate-bounce { animation: bounce 1.4s infinite ease-in-out both; }
  </style>
</AppLayout>
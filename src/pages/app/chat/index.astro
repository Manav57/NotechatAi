---
import AppLayout from '../../../layouts/AppLayout.astro';
import Button from '../../../components/ui/Button.astro';
import Input from '../../../components/ui/Input.astro';
import Card from '../../../components/ui/Card.astro';
import Badge from '../../../components/ui/Badge.astro';
---

<AppLayout title="Chat — NotesChatAI" user={{ name: 'Demo User', email: 'demo@noteschatai.com', plan: 'free' }}>
  <div class="h-[calc(100vh-64px)] flex flex-col">
    <!-- Sidebar -->
    <aside class="hidden lg:block w-80 bg-canvas border-r border-hairline flex flex-col">
      <div class="p-4 border-b border-hairline flex items-center justify-between">
        <h2 class="font-display-sm text-ink">Conversations</h2>
        <Button variant="primary-sm" size="sm" class="w-full" id="new-chat-btn">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="mr-1.5" aria-hidden="true">
            <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          New Chat
        </Button>
      </div>
      <div class="flex-1 overflow-y-auto divide-y divide-hairline" id="conversation-list">
        {[
          { id: '1', title: 'Transformer architectures', updated: '4 hours ago', messages: 12 },
          { id: '2', title: 'RNN vs LSTM comparison', updated: '1 day ago', messages: 8 },
          { id: '3', title: 'Attention mechanism deep dive', updated: '2 days ago', messages: 15 },
          { id: '4', title: 'ML fundamentals review', updated: '3 days ago', messages: 6 },
        ].map((conv) => (
          <a href={`/app/chat/${conv.id}`} class="block p-4 hover:bg-canvas-soft transition-colors">
            <p class="font-body-md text-ink truncate mb-1">{conv.title}</p>
            <div class="flex items-center gap-2 font-body-sm text-mute">
              <span>{conv.updated}</span>
              <span>·</span>
              <span>{conv.messages} messages</span>
            </div>
          </a>
        ))}
      </div>
      <div class="p-4 border-t border-hairline">
        <a href="/app/chat/history" class="font-body-sm link-inline">View all conversations</a>
      </div>
    </aside>

    <!-- Main Chat Area -->
    <main class="flex-1 flex flex-col min-w-0">
      <div class="flex-1 flex flex-col overflow-hidden">
        <!-- Chat Header -->
        <header class="bg-canvas border-b border-hairline px-6 py-4">
          <div class="flex items-center justify-between">
            <div>
              <h1 class="font-display-md text-ink">New Conversation</h1>
              <p class="font-body-sm text-mute">Ask anything about your knowledge base</p>
            </div>
            <div class="flex items-center gap-3">
              <select id="model-select" class="input h-10 w-auto">
                <option value="gemini-1.5-flash">Gemini 1.5 Flash (Fast)</option>
                <option value="gemini-1.5-pro">Gemini 1.5 Pro (Best)</option>
                <option value="gemini-2.0-flash">Gemini 2.0 Flash</option>
              </select>
              <Button variant="ghost" size="sm" aria-label="Settings">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                  <circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M9 13.5V15M9 3v1.5M15 9h1.5M3 9H4.5M4.94 4.94l1.06 1.06M12 12l1.06 1.06M4.94 13.06l1.06-1.06M12 6.94l1.06-1.06" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </Button>
            </div>
          </div>
        </header>

        <!-- Messages Area -->
        <div class="flex-1 overflow-y-auto p-6 space-y-6" id="messages-container">
          <!-- Welcome State -->
          <div class="flex flex-col items-center justify-center h-full text-center" id="welcome-state">
            <div class="w-20 h-20 bg-primary/10 rounded-2xl flex items-center justify-center mb-6">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none" class="text-primary" aria-hidden="true">
                <path d="M20 8a12 12 0 1 0 0 24 12 12 0 0 0 0-24z" stroke="currentColor" stroke-width="2"/>
                <path d="M20 14v6M20 26h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
            <h2 class="font-display-lg text-ink mb-3">Start a conversation</h2>
            <p class="font-body-lg text-body max-w-md mb-8">
              Ask questions, get summaries, or explore concepts across your entire knowledge base. Every answer includes citations from your documents.
            </p>
            <div class="grid sm:grid-cols-2 gap-4 max-w-md w-full">
              {[
                'Summarize my ML notes',
                'Explain attention mechanism',
                'Compare RNN vs Transformer',
                'Generate study questions',
              ].map((suggestion) => (
                <button class="suggestion-btn btn-secondary text-left p-4 hover:bg-canvas-soft transition-colors" data-suggestion={suggestion}>
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="mr-3 text-mute" aria-hidden="true">
                    <path d="M10 3v14M3 10h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                  <span class="font-body-md text-ink">{suggestion}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- Messages (hidden initially) -->
          <div id="messages-list" class="hidden space-y-6">
            <!-- Messages will be inserted here -->
          </div>
        </div>

        <!-- Composer -->
        <div class="bg-canvas border-t border-hairline p-4">
          <div class="max-w-3xl mx-auto">
            <div class="flex items-end gap-3 mb-3">
              <div class="flex items-center gap-2">
                <Button variant="ghost" size="sm" aria-label="Attach file">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path d="M13.5 4.5L9 9l-4.5-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M9 9v7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M4.5 13.5h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </Button>
                <Button variant="ghost" size="sm" aria-label="Search knowledge base">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M13.5 13.5L16.5 16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </Button>
              </div>
              <form id="chat-form" class="flex-1 flex items-end gap-3">
                <textarea
                  id="chat-input"
                  placeholder="Ask anything about your documents..."
                  class="input resize-none min-h-[44px] max-h-48 flex-1"
                  rows="1"
                  aria-label="Message"
                ></textarea>
                <Button type="submit" variant="primary" size="lg" aria-label="Send message">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M17.5 10.5L6.5 18.5V10.5L17.5 10.5Z" fill="currentColor"/>
                    <path d="M6.5 1.5L17.5 9.5V1.5L6.5 1.5Z" fill="currentColor" opacity="0.5"/>
                  </svg>
                </Button>
              </form>
            </div>
            <p class="font-caption text-mute text-center">
              Powered by Gemini 1.5 Flash · Responses are grounded in your documents · <a href="/privacy" class="link-inline">Privacy</a>
            </p>
          </div>
        </div>
      </div>
    </main>
  </div>
</AppLayout>

<script type="module">
  import { ChatClient } from '../../../components/ChatClient/ChatClient.tsx';
</script>
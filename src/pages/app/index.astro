export const prerender = false;
---
import AppLayout from '../../layouts/AppLayout.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';

const user = (Astro.locals as any)?.user;

// Fetch real data server-side
let docCount = 0;
let convCount = 0;
let readyCount = 0;
let processingCount = 0;
let recentDocs: any[] = [];

try {
  const docsRes = await fetch(`${Astro.url.origin}/api/documents`, {
    headers: { Cookie: Astro.request.headers.get('cookie') || '' },
  });
  if (docsRes.ok) {
    const docsData = await docsRes.json();
    docCount = docsData.stats?.totalDocuments || 0;
    readyCount = docsData.stats?.readyCount || 0;
    processingCount = docsData.stats?.processingCount || 0;
    recentDocs = (docsData.documents || []).slice(0, 5);
  }
} catch {}

try {
  const convsRes = await fetch(`${Astro.url.origin}/api/chat`, {
    headers: { Cookie: Astro.request.headers.get('cookie') || '' },
  });
  if (convsRes.ok) {
    const convsData = await convsRes.json();
    convCount = (convsData.conversations || []).length;
  }
} catch {}
---

<AppLayout title="Dashboard — NotesChatAI">
  <div class="space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="font-display-lg text-ink">Dashboard</h1>
        <p class="font-body-md text-body mt-1">Welcome back, {user?.name || 'there'}! Here's what's happening with your knowledge base.</p>
      </div>
      <div class="flex gap-3">
        <a href="/app/documents" class="btn-primary">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="mr-2" aria-hidden="true">
            <path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          Add Document
        </a>
        <a href="/app/chat" class="btn-secondary">Start Chat</a>
      </div>
    </div>

    <div id="stats-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <Card variant="marketing">
        <div class="flex items-center justify-between mb-2">
          <span class="font-caption-mono text-mute uppercase tracking-wider">Documents</span>
          <Badge variant="secondary">{docCount} total</Badge>
        </div>
        <p class="font-display-xl text-ink">{docCount}</p>
        <p class="font-body-sm text-mute mt-1">Total in knowledge base</p>
      </Card>

      <Card variant="marketing">
        <div class="flex items-center justify-between mb-2">
          <span class="font-caption-mono text-mute uppercase tracking-wider">Conversations</span>
          <Badge variant="secondary">All time</Badge>
        </div>
        <p class="font-display-xl text-ink">{convCount}</p>
        <p class="font-body-sm text-mute mt-1">Chat sessions started</p>
      </Card>

      <Card variant="marketing">
        <div class="flex items-center justify-between mb-2">
          <span class="font-caption-mono text-mute uppercase tracking-wider">Ready</span>
          <Badge variant="success">Ready</Badge>
        </div>
        <p class="font-display-xl text-ink">{readyCount}</p>
        <p class="font-body-sm text-mute mt-1">Documents processed</p>
      </Card>

      <Card variant="marketing">
        <div class="flex items-center justify-between mb-2">
          <span class="font-caption-mono text-mute uppercase tracking-wider">Processing</span>
          <Badge variant="warning">Queue</Badge>
        </div>
        <p class="font-display-xl text-ink">{processingCount}</p>
        <p class="font-body-sm text-mute mt-1">Documents in queue</p>
      </Card>
    </div>

    <div class="grid lg:grid-cols-2 gap-6">
      <Card variant="marketing-large">
        <h2 class="font-display-md text-ink mb-6">Quick Actions</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          <a href="/app/documents" class="card-marketing p-6 hover:shadow-level-4 transition-shadow group">
            <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center mb-4 group-hover:bg-violet transition-colors">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-on-primary" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M14 2v6h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M16 13H8M16 17H8M10 9H8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="font-display-sm text-ink mb-1">Upload Document</h3>
            <p class="font-body-sm text-body">Add PDFs, EPUBs, YouTube links, or web pages to your knowledge base.</p>
          </a>

          <a href="/app/chat" class="card-marketing p-6 hover:shadow-level-4 transition-shadow group">
            <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center mb-4 group-hover:bg-violet transition-colors">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-on-primary" aria-hidden="true">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="font-display-sm text-ink mb-1">Start Chatting</h3>
            <p class="font-body-sm text-body">Ask questions across your entire knowledge base with citations.</p>
          </a>

          <a href="/app/audio" class="card-marketing p-6 hover:shadow-level-4 transition-shadow group">
            <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center mb-4 group-hover:bg-violet transition-colors">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-on-primary" aria-hidden="true">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                <polygon points="10,8 16,12 10,16" fill="currentColor"/>
              </svg>
            </div>
            <h3 class="font-display-sm text-ink mb-1">Generate Audio</h3>
            <p class="font-body-sm text-body">Create podcast-style summaries with transcripts and chapters.</p>
          </a>

          <a href="/app/mindmap" class="card-marketing p-6 hover:shadow-level-4 transition-shadow group">
            <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center mb-4 group-hover:bg-violet transition-colors">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-on-primary" aria-hidden="true">
                <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/>
                <path d="M12 2v2m0 16v2M2 12h2m16 0h2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="font-display-sm text-ink mb-1">View Mind Map</h3>
            <p class="font-body-sm text-body">Explore connections between concepts across your documents.</p>
          </a>
        </div>
      </Card>

      <Card variant="marketing-large">
        <div class="flex items-center justify-between mb-6">
          <h2 class="font-display-md text-ink">Recent Documents</h2>
          <a href="/app/documents" class="font-body-sm link-inline">View all</a>
        </div>
        <div id="recent-docs" class="space-y-3">
          {recentDocs.length === 0 ? (
            <p class="font-body-sm text-mute text-center py-8">No documents yet. Upload your first document to get started!</p>
          ) : (
            recentDocs.map((doc: any) => (
              <div class="flex items-center gap-3 p-3 bg-canvas-soft/50 rounded-lg hover:bg-canvas-soft transition-colors">
                <div class="w-9 h-9 rounded-lg bg-canvas-soft-2 flex items-center justify-center flex-shrink-0">
                  <span class="font-caption-mono text-[10px] font-medium text-mute uppercase">{doc.type}</span>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="font-body-sm text-ink truncate">{doc.title}</p>
                  <p class="font-caption text-mute">{doc.chunkCount} chunks · {new Date(doc.createdAt).toLocaleDateString()}</p>
                </div>
              </div>
            ))
          )}
        </div>
      </Card>
    </div>

    <Card variant="marketing-large">
      <div class="flex items-center justify-between mb-6">
        <h2 class="font-display-md text-ink">Your Plan: Free Beta</h2>
        <a href="/pricing" class="btn-secondary-sm">Upgrade to Pro</a>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        <div class="text-center p-4 bg-canvas-soft/50 rounded-lg">
          <p class="font-display-xl text-ink">50</p>
          <p class="font-body-sm text-mute">Documents</p>
        </div>
        <div class="text-center p-4 bg-canvas-soft/50 rounded-lg">
          <p class="font-display-xl text-ink">30</p>
          <p class="font-body-sm text-mute">Chats / day</p>
        </div>
        <div class="text-center p-4 bg-canvas-soft/50 rounded-lg">
          <p class="font-display-xl text-ink">2</p>
          <p class="font-body-sm text-mute">Audio / day</p>
        </div>
      </div>
    </Card>
  </div>


</AppLayout>

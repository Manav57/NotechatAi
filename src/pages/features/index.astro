---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/ui/NavBar.astro';
import HeroBand from '../../components/ui/HeroBand.astro';
import FeatureMeshBand from '../../components/ui/FeatureMeshBand.astro';
import ShowcaseBandDark from '../../components/ui/ShowcaseBandDark.astro';
import Footer from '../../components/ui/Footer.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
---

<Layout title="Features — NotesChatAI vs NotebookLM | AI Study Assistant" description="Full feature comparison: why NotesChatAI is the better AI study assistant and free NotebookLM alternative. Persistent memory, unlimited sources, API access, flashcard generator, and more." keywords="notebooklm alternative, ai study assistant, features, persistent ai memory, chat with pdf ai, ai flashcard generator, api access">
  <NavBar user={null} />

  <main>
    {/* ═══════════════ HERO ═══════════════ */}
    <section class="hero-band relative overflow-hidden" aria-labelledby="features-hero-title">
      <div class="absolute inset-0 mesh-gradient-bg opacity-[0.08]" aria-hidden="true"></div>
      <div class="max-w-[1400px] mx-auto px-4 lg:px-8 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <span class="badge-secondary inline-flex items-center gap-1.5 mb-6 font-caption-mono">
            Feature Comparison
          </span>
          <h1 id="features-hero-title" class="font-display-xl text-ink mb-6 text-balance">
            Every feature. Side by side.
          </h1>
          <p class="font-body-lg text-body mb-8 text-balance max-w-2xl mx-auto">
            A detailed comparison of NotesChatAI and NotebookLM across every dimension that matters for students and researchers.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/auth/signup" class="btn-primary">Start Free Beta</a>
            <a href="#comparison-table" class="btn-secondary">Jump to Comparison</a>
          </div>
        </div>
      </div>
    </section>

    {/* ═══════════════ FULL COMPARISON TABLE ═══════════════ */}
    <section id="comparison-table" class="showcase-band-light relative scroll-mt-20" aria-labelledby="table-title">
      <div class="max-w-[1400px] mx-auto px-4 lg:px-8">
        <div class="text-center mb-12">
          <span class="font-caption-mono text-violet uppercase tracking-wider text-xs mb-3 block">Head to head</span>
          <h2 id="table-title" class="font-display-lg text-ink mb-4 text-balance">
            NotesChatAI vs NotebookLM
          </h2>
          <p class="font-body-lg text-body max-w-2xl mx-auto">
            We compared every feature, limit, and capability. Here's the full picture.
          </p>
        </div>

        {/* Category: Knowledge Base */}
        <div class="max-w-5xl mx-auto mb-12">
          <h3 class="font-display-sm text-ink mb-4 flex items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="text-violet" aria-hidden="true">
              <rect x="2" y="3" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M6 7h8M6 10h5M6 13h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Knowledge Base & Sources
          </h3>
          <div class="bg-canvas rounded-xl border border-hairline overflow-hidden shadow-level-2">
            <div class="grid grid-cols-3 bg-canvas-soft border-b border-hairline">
              <div class="p-4"><span class="font-caption-mono text-mute uppercase text-xs tracking-wider">Feature</span></div>
              <div class="p-4 text-center border-x border-hairline">
                <span class="font-body-sm-strong text-ink">NotesChatAI</span>
              </div>
              <div class="p-4 text-center">
                <span class="font-body-sm-strong text-body">NotebookLM</span>
              </div>
            </div>
            {[
              { f: 'Architecture', nc: 'Unified knowledge base', nlm: 'Separate notebooks (isolated)' },
              { f: 'Cross-notebook search', nc: true, nlm: 'Not possible' },
              { f: 'Source limit per project', nc: 'Unlimited', nlm: '50 (Free) → 600 (Ultra)' },
              { f: 'Max words per source', nc: 'No limit', nlm: '500,000 words' },
              { f: 'Max file size', nc: '200 MB', nlm: '200 MB' },
              { f: 'Supported formats', nc: 'PDF, EPUB, DOCX, TXT, MDX, MP3, WAV, YouTube, URLs', nlm: 'PDF, DOCX, Google Docs, YouTube, audio, URLs' },
              { f: 'Import from', nc: 'Obsidian, Roam, Notion, Anki, GitHub', nlm: 'Google Drive only' },
              { f: 'OCR (scanned PDFs)', nc: true, nlm: true },
              { f: 'Auto-indexing', nc: 'Real-time vector embeddings', nlm: 'Batch processing' },
            ].map((row) => (
              <div class="grid grid-cols-3 border-b border-hairline last:border-b-0 hover:bg-canvas-soft/50 transition-colors">
                <div class="p-4 flex items-center"><span class="font-body-sm text-ink">{row.f}</span></div>
                <div class="p-4 flex items-center justify-center border-x border-hairline bg-violet/5">
                  {typeof row.nc === 'boolean' ? (
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-success" aria-hidden="true">
                      <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  ) : (
                    <span class="font-body-sm text-ink text-center">{row.nc}</span>
                  )}
                </div>
                <div class="p-4 flex items-center justify-center">
                  {typeof row.nlm === 'boolean' ? (
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-success" aria-hidden="true">
                      <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  ) : (
                    <span class="font-body-sm text-body text-center">{row.nlm}</span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Category: Chat & AI */}
        <div class="max-w-5xl mx-auto mb-12">
          <h3 class="font-display-sm text-ink mb-4 flex items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="text-cyan-deep" aria-hidden="true">
              <path d="M17 10a7 7 0 0 1-7 7H4l-2 2V3a7 7 0 0 1 14 0z" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            Chat & AI Capabilities
          </h3>
          <div class="bg-canvas rounded-xl border border-hairline overflow-hidden shadow-level-2">
            <div class="grid grid-cols-3 bg-canvas-soft border-b border-hairline">
              <div class="p-4"><span class="font-caption-mono text-mute uppercase text-xs tracking-wider">Feature</span></div>
              <div class="p-4 text-center border-x border-hairline"><span class="font-body-sm-strong text-ink">NotesChatAI</span></div>
              <div class="p-4 text-center"><span class="font-body-sm-strong text-body">NotebookLM</span></div>
            </div>
            {[
              { f: 'Daily chat limit', nc: 'Unlimited (Pro)', nlm: '50 (Free) → 5,000 (Ultra)' },
              { f: 'Chat history', nc: 'Permanent, searchable', nlm: 'Saved (added Oct 2025)' },
              { f: 'Cross-session context', nc: true, nlm: 'Per-notebook only' },
              { f: 'Citations', nc: 'Page + paragraph + confidence', nlm: 'Source-level only' },
              { f: 'Citation verification', nc: 'Confidence scores + exact location', nlm: 'Click to source' },
              { f: 'Model choice', nc: 'Gemini, Claude, GPT, local', nlm: 'Gemini only' },
              { f: 'Streaming responses', nc: true, nlm: true },
              { f: 'Custom personas/goals', nc: 'Global + per-conversation', nlm: 'Per-notebook (5,000 chars)' },
              { f: 'Multi-language', nc: true, nlm: true },
            ].map((row) => (
              <div class="grid grid-cols-3 border-b border-hairline last:border-b-0 hover:bg-canvas-soft/50 transition-colors">
                <div class="p-4 flex items-center"><span class="font-body-sm text-ink">{row.f}</span></div>
                <div class="p-4 flex items-center justify-center border-x border-hairline bg-violet/5">
                  {typeof row.nc === 'boolean' ? (
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-success" aria-hidden="true"><circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  ) : (
                    <span class="font-body-sm text-ink text-center">{row.nc}</span>
                  )}
                </div>
                <div class="p-4 flex items-center justify-center">
                  {typeof row.nlm === 'boolean' ? (
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-success" aria-hidden="true"><circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  ) : (
                    <span class="font-body-sm text-body text-center">{row.nlm}</span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Category: Study Tools */}
        <div class="max-w-5xl mx-auto mb-12">
          <h3 class="font-display-sm text-ink mb-4 flex items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="text-highlight-pink" aria-hidden="true">
              <rect x="3" y="4" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M7 8h6M7 11h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Study Tools
          </h3>
          <div class="bg-canvas rounded-xl border border-hairline overflow-hidden shadow-level-2">
            <div class="grid grid-cols-3 bg-canvas-soft border-b border-hairline">
              <div class="p-4"><span class="font-caption-mono text-mute uppercase text-xs tracking-wider">Feature</span></div>
              <div class="p-4 text-center border-x border-hairline"><span class="font-body-sm-strong text-ink">NotesChatAI</span></div>
              <div class="p-4 text-center"><span class="font-body-sm-strong text-body">NotebookLM</span></div>
            </div>
            {[
              { f: 'Flashcards', nc: 'Auto-generated, FSRS spaced repetition', nlm: 'Not available' },
              { f: 'Quiz mode', nc: 'MCQ, short answer, timed practice', nlm: 'Not available' },
              { f: 'Practice exams', nc: 'Customizable, auto-graded', nlm: 'Not available' },
              { f: 'Study planner', nc: 'Exam dates, daily goals, adaptive', nlm: 'Not available' },
              { f: 'Knowledge graph', nc: 'Interactive mind map, zoom, filter', nlm: 'Basic mind map output' },
              { f: 'Anki export', nc: '.apkg direct export', nlm: 'Not available' },
              { f: 'Retention tracking', nc: 'Per-card mastery, streak, analytics', nlm: 'Not available' },
              { f: 'Study groups', nc: 'Shared knowledge bases, real-time', nlm: 'Basic notebook sharing' },
            ].map((row) => (
              <div class="grid grid-cols-3 border-b border-hairline last:border-b-0 hover:bg-canvas-soft/50 transition-colors">
                <div class="p-4 flex items-center"><span class="font-body-sm text-ink">{row.f}</span></div>
                <div class="p-4 flex items-center justify-center border-x border-hairline bg-violet/5">
                  <span class="font-body-sm text-ink text-center">{row.nc}</span>
                </div>
                <div class="p-4 flex items-center justify-center">
                  <span class="font-body-sm text-mute text-center">{row.nlm}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Category: Audio & Media */}
        <div class="max-w-5xl mx-auto mb-12">
          <h3 class="font-display-sm text-ink mb-4 flex items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="text-warning" aria-hidden="true">
              <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5"/>
              <polygon points="8,7 13,10 8,13" fill="currentColor"/>
            </svg>
            Audio & Media
          </h3>
          <div class="bg-canvas rounded-xl border border-hairline overflow-hidden shadow-level-2">
            <div class="grid grid-cols-3 bg-canvas-soft border-b border-hairline">
              <div class="p-4"><span class="font-caption-mono text-mute uppercase text-xs tracking-wider">Feature</span></div>
              <div class="p-4 text-center border-x border-hairline"><span class="font-body-sm-strong text-ink">NotesChatAI</span></div>
              <div class="p-4 text-center"><span class="font-body-sm-strong text-body">NotebookLM</span></div>
            </div>
            {[
              { f: 'Audio overviews', nc: 'Two-host podcast style', nlm: 'Two-host Deep Dive' },
              { f: 'Daily audio limit', nc: 'Unlimited (Pro)', nlm: '3 (Free) → 200 (Ultra)' },
              { f: 'Full transcripts', nc: 'Word-level timestamps, search', nlm: 'Available' },
              { f: 'Chapter markers', nc: 'Auto-generated, editable', nlm: 'Basic' },
              { f: 'Playback speed', nc: '0.5x – 2x', nlm: '0.5x – 2x' },
              { f: 'Offline download', nc: 'MP3 export', nlm: 'Not available' },
              { f: 'Saved library', nc: 'Organize, share, playlist', nlm: 'Saved in notebook' },
              { f: 'Video overviews', nc: 'Coming soon', nlm: 'Veo 3 (Ultra only)' },
              { f: 'Slides / PPTX export', nc: 'Coming soon', nlm: 'Available (Feb 2026)' },
              { f: 'Data tables', nc: 'Coming soon', nlm: 'Google Sheets export' },
            ].map((row) => (
              <div class="grid grid-cols-3 border-b border-hairline last:border-b-0 hover:bg-canvas-soft/50 transition-colors">
                <div class="p-4 flex items-center"><span class="font-body-sm text-ink">{row.f}</span></div>
                <div class="p-4 flex items-center justify-center border-x border-hairline bg-violet/5">
                  <span class="font-body-sm text-ink text-center">{row.nc}</span>
                </div>
                <div class="p-4 flex items-center justify-center">
                  <span class="font-body-sm text-body text-center">{row.nlm}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Category: Platform & API */}
        <div class="max-w-5xl mx-auto mb-12">
          <h3 class="font-display-sm text-ink mb-4 flex items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="text-success" aria-hidden="true">
              <path d="M16 8a8 8 0 0 1-8 8H2l-1 1V2a8 8 0 0 1 15-1z" stroke="currentColor" stroke-width="1.5" fill="none"/>
            </svg>
            Platform & Developer
          </h3>
          <div class="bg-canvas rounded-xl border border-hairline overflow-hidden shadow-level-2">
            <div class="grid grid-cols-3 bg-canvas-soft border-b border-hairline">
              <div class="p-4"><span class="font-caption-mono text-mute uppercase text-xs tracking-wider">Feature</span></div>
              <div class="p-4 text-center border-x border-hairline"><span class="font-body-sm-strong text-ink">NotesChatAI</span></div>
              <div class="p-4 text-center"><span class="font-body-sm-strong text-body">NotebookLM</span></div>
            </div>
            {[
              { f: 'REST API', nc: true, nlm: 'Not available' },
              { f: 'GraphQL API', nc: true, nlm: 'Not available' },
              { f: 'Webhooks', nc: true, nlm: 'Not available' },
              { f: 'SDKs', nc: 'TypeScript, Python, Go', nlm: 'Not available' },
              { f: 'Self-hosted option', nc: 'Docker (Pro/Enterprise)', nlm: 'Not available' },
              { f: 'Export formats', nc: 'MD, JSON, CSV, Anki, Notion, Obsidian', nlm: 'Notes text only' },
              { f: 'Embeddings API', nc: true, nlm: 'Not available' },
              { f: 'Custom model hosting', nc: 'Workers AI, local', nlm: 'Not available' },
            ].map((row) => (
              <div class="grid grid-cols-3 border-b border-hairline last:border-b-0 hover:bg-canvas-soft/50 transition-colors">
                <div class="p-4 flex items-center"><span class="font-body-sm text-ink">{row.f}</span></div>
                <div class="p-4 flex items-center justify-center border-x border-hairline bg-violet/5">
                  {typeof row.nc === 'boolean' ? (
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-success" aria-hidden="true"><circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  ) : (
                    <span class="font-body-sm text-ink text-center">{row.nc}</span>
                  )}
                </div>
                <div class="p-4 flex items-center justify-center">
                  {typeof row.nlm === 'boolean' ? (
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-success" aria-hidden="true"><circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  ) : (
                    <span class="font-body-sm text-mute text-center">{row.nlm}</span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Category: Pricing */}
        <div class="max-w-5xl mx-auto mb-12">
          <h3 class="font-display-sm text-ink mb-4 flex items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="text-link" aria-hidden="true">
              <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5"/>
              <path d="M10 5v10M7.5 7.5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5-2.5 1.12-2.5 2.5 1.12 2.5 2.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Pricing & Limits
          </h3>
          <div class="bg-canvas rounded-xl border border-hairline overflow-hidden shadow-level-2">
            <div class="grid grid-cols-3 bg-canvas-soft border-b border-hairline">
              <div class="p-4"><span class="font-caption-mono text-mute uppercase text-xs tracking-wider">Feature</span></div>
              <div class="p-4 text-center border-x border-hairline"><span class="font-body-sm-strong text-ink">NotesChatAI</span></div>
              <div class="p-4 text-center"><span class="font-body-sm-strong text-body">NotebookLM</span></div>
            </div>
            {[
              { f: 'Free tier', nc: '50 docs, 30 chats/day, 2 audio/day', nlm: '50 sources, 50 chats/day, 3 audio/day' },
              { f: 'Pro price', nc: '$9.99/mo', nlm: '$19.99/mo (AI Pro)' },
              { f: 'Enterprise', nc: 'Self-hosted, custom limits', nlm: 'Google Workspace' },
              { f: 'API included', nc: 'All paid plans', nlm: 'Not available' },
              { f: 'Storage', nc: 'Unlimited (Pro)', nlm: '2 TB (Pro) → 5 TB (Ultra)' },
              { f: 'Team features', nc: 'Shared KB, roles, audit log', nlm: 'Basic sharing' },
              { f: 'Data portability', nc: 'Full export, any format', nlm: 'Limited notes export' },
              { f: 'Uptime SLA', nc: '99.9% (Enterprise)', nlm: 'Google SLA' },
            ].map((row) => (
              <div class="grid grid-cols-3 border-b border-hairline last:border-b-0 hover:bg-canvas-soft/50 transition-colors">
                <div class="p-4 flex items-center"><span class="font-body-sm text-ink">{row.f}</span></div>
                <div class="p-4 flex items-center justify-center border-x border-hairline bg-violet/5">
                  <span class="font-body-sm text-ink text-center">{row.nc}</span>
                </div>
                <div class="p-4 flex items-center justify-center">
                  <span class="font-body-sm text-body text-center">{row.nlm}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Where NotebookLM Wins — honest */}
        <div class="max-w-5xl mx-auto mb-8">
          <div class="bg-canvas-soft rounded-xl border border-hairline p-6 lg:p-8">
            <h3 class="font-display-sm text-ink mb-4 flex items-center gap-2">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="text-link" aria-hidden="true">
                <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5"/>
                <path d="M10 6v5M10 13.5h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              Where NotebookLM Leads
            </h3>
            <p class="font-body-sm text-body mb-4">We believe in transparency. Here's where NotebookLM currently has advantages:</p>
            <div class="grid sm:grid-cols-2 gap-4">
              <div class="flex items-start gap-3 p-3 bg-canvas rounded-lg">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-link flex-shrink-0 mt-0.5" aria-hidden="true">
                  <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M9 6v4M9 12.5h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <div>
                  <p class="font-body-sm-strong text-ink">Cinematic Video Overviews</p>
                  <p class="font-caption text-body">Veo 3 AI-generated video (Ultra only)</p>
                </div>
              </div>
              <div class="flex items-start gap-3 p-3 bg-canvas rounded-lg">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-link flex-shrink-0 mt-0.5" aria-hidden="true">
                  <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M9 6v4M9 12.5h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <div>
                  <p class="font-body-sm-strong text-ink">Slides & PPTX Export</p>
                  <p class="font-caption text-body">Auto-generated presentations (available now)</p>
                </div>
              </div>
              <div class="flex items-start gap-3 p-3 bg-canvas rounded-lg">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-link flex-shrink-0 mt-0.5" aria-hidden="true">
                  <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M9 6v4M9 12.5h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <div>
                  <p class="font-body-sm-strong text-ink">Google Drive Integration</p>
                  <p class="font-caption text-body">Native Google ecosystem sync</p>
                </div>
              </div>
              <div class="flex items-start gap-3 p-3 bg-canvas rounded-lg">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-link flex-shrink-0 mt-0.5" aria-hidden="true">
                  <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M9 6v4M9 12.5h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <div>
                  <p class="font-body-sm-strong text-ink">Deep Research (Web Search)</p>
                  <p class="font-caption text-body">Agentic web research with citations</p>
                </div>
              </div>
            </div>
            <p class="font-body-sm text-body mt-4">These features are on our roadmap. Video generation, slides export, and web research are coming to NotesChatAI.</p>
          </div>
        </div>
      </div>

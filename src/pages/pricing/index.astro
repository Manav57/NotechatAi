---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/ui/NavBar.astro';
import Footer from '../../components/ui/Footer.astro';
import Badge from '../../components/ui/Badge.astro';
import UpgradeModal from '../../components/ui/UpgradeModal.astro';
import { PLAN_PRICES, formatMonthly, annualPerMonth, annualSavingsPct } from '../../lib/pricing';

// Comparison table rows (NotesChatAI side sourced from src/lib/pricing.ts)
const comparisonRows = [
  { plan: 'Free', nc: `$${PLAN_PRICES.free.monthly} — 50 docs, 30 chats/day`, nlm: '$0 — 50 sources, 50 chats/day' },
  { plan: 'Pro', nc: `$${PLAN_PRICES.pro.monthly}/mo — 500 docs, 300 chats/day, 25 GB`, nlm: '$19.99/mo — 300 sources, 500 chats/day' },
  { plan: 'Plus', nc: `$${PLAN_PRICES.plus.monthly}/mo — Unlimited docs & chats, 100 GB`, nlm: '$19.99/mo Ultra — 600 sources, 5000 chats/day' },
];
---

<Layout title="Pricing — NotesChatAI | Free AI Study Assistant" description="Simple, transparent pricing for NotesChatAI. Free beta with 50 documents. Pro for unlimited docs and chats. Better value than NotebookLM." keywords="noteschatai pricing, free notebooklm alternative, ai study assistant pricing, free ai study assistant">
  <NavBar user={null} />

  <main>
    {/* ═══════════════ HERO ═══════════════ */}
    <section class="hero-band relative overflow-hidden" aria-labelledby="pricing-hero">
      <div class="absolute inset-0 mesh-gradient-bg opacity-[0.06]" aria-hidden="true"></div>
      <div class="max-w-[1400px] mx-auto px-4 lg:px-8 relative z-10">
        <div class="max-w-3xl mx-auto text-center">
          <span class="badge-secondary inline-flex items-center gap-1.5 mb-6 font-caption-mono">
            <span class="w-2 h-2 rounded-full bg-success animate-pulse"></span>
            Free Beta
          </span>
          <h1 id="pricing-hero" class="font-display-xl text-ink mb-4 text-balance">
            Simple, transparent pricing
          </h1>
          <p class="font-body-lg text-body mb-8 text-balance">
            Start free. Upgrade when you need more. No surprises. All plans include persistent memory, global search, and citations.
          </p>

          {/* Simple pricing — no toggle needed */}
        </div>
      </div>
    </section>

    {/* ═══════════════ PRICING CARDS ═══════════════ */}
    <section class="showcase-band-light relative" aria-labelledby="plans-title">
      <div class="max-w-[1400px] mx-auto px-4 lg:px-8">
        <div class="text-center mb-12">
          <h2 id="plans-title" class="font-display-lg text-ink mb-4">Choose Your Plan</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6 lg:gap-8 max-w-5xl mx-auto items-start">
          {/* Free */}
          <div class="bg-canvas rounded-xl border border-hairline p-8 shadow-level-2">
            <div class="mb-6">
              <h3 class="font-display-md text-ink mb-1">Free</h3>
              <p class="font-body-sm text-body">For students and casual learners</p>
            </div>
            <div class="mb-6">
              <span class="font-display-xl text-ink">${PLAN_PRICES.free.monthly}</span>
              <span class="font-body-md text-mute ml-1">/month</span>
            </div>
            <Badge variant="secondary" class="mb-6">Current Beta</Badge>
            <ul class="space-y-3 mb-8" role="list">
              {[
                '50 documents',
                '30 chats per day',
                '2 audio overviews per day',
                '1 GB storage',
                'Global semantic search',
                'Cross-document citations',
                'Mind maps & flashcards',
                'Export to Markdown, PDF, Anki',
                'Community support',
              ].map((item) => (
                <li class="flex items-center gap-3 font-body-sm text-body">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-cyan-deep flex-shrink-0" aria-hidden="true">
                    <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <a href="/auth/signup" class="btn-secondary w-full text-center block h-11 leading-11">Start Free</a>
          </div>

          {/* Pro — Featured */}
          <div class="bg-primary rounded-xl p-8 shadow-level-4 relative md:-mt-4 md:mb-4">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2">
              <span class="bg-cyan text-primary font-body-sm-strong px-4 py-1 rounded-full shadow-level-2">Most Popular</span>
            </div>
            <div class="mb-6">
              <h3 class="font-display-md text-on-primary mb-1">Pro</h3>
              <p class="font-body-sm text-on-primary/70">For power users who need more</p>
            </div>
            <div class="mb-2">
              <span class="font-display-xl text-on-primary">${PLAN_PRICES.pro.monthly}</span>
              <span class="font-body-md text-on-primary/50 ml-1">/month</span>
            </div>
            <p class="font-body-sm text-on-primary/50 mb-6">Cancel anytime · {annualSavingsPct('pro')}% off yearly ({formatMonthly('pro')} → ${annualPerMonth('pro')}/mo billed annually)</p>
            <ul class="space-y-3 mb-8" role="list">
              {[
                '500 documents',
                '300 chats per day',
                '20 audio overviews per day',
                '25 GB storage',
                'Priority processing',
                'Global semantic search',
                'Cross-document citations',
                'Mind maps & flashcards',
                'Export to Markdown, PDF, Anki',
                'Email support',
              ].map((item) => (
                <li class="flex items-center gap-3 font-body-sm text-on-primary/90">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-cyan-soft flex-shrink-0" aria-hidden="true">
                    <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <button onclick="handleUpgrade('pro')" class="w-full h-11 flex items-center justify-center rounded-pill bg-on-primary text-primary font-button-lg hover:opacity-90 active:opacity-70 transition-all">Upgrade to Pro</button>
          </div>

          {/* Plus */}
          <div class="bg-canvas rounded-xl border border-hairline p-8 shadow-level-2">
            <div class="mb-6">
              <h3 class="font-display-md text-ink mb-1">Plus</h3>
              <p class="font-body-sm text-body">For teams and institutions</p>
            </div>
            <div class="mb-2">
              <span class="font-display-xl text-ink">${PLAN_PRICES.plus.monthly}</span>
              <span class="font-body-md text-mute ml-1">/month</span>
            </div>
            <p class="font-body-sm text-mute mb-6">Cancel anytime · {annualSavingsPct('plus')}% off yearly ({formatMonthly('plus')} → ${annualPerMonth('plus')}/mo billed annually)</p>
            <ul class="space-y-3 mb-8" role="list">
              {[
                'Unlimited documents',
                'Unlimited chats',
                '100 audio overviews per day',
                '100 GB storage',
                'Priority processing',
                'API access',
                'Real-time collaboration',
                'Advanced export (Obsidian, Notion)',
                'Priority support (4h SLA)',
                'Custom integrations',
              ].map((item) => (
                <li class="flex items-center gap-3 font-body-sm text-body">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-cyan-deep flex-shrink-0" aria-hidden="true">
                    <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <button onclick="handleUpgrade('plus')" class="btn-secondary w-full text-center h-11 leading-11">Upgrade to Plus</button>
          </div>
        </div>

        <p class="text-center mt-8 font-body-sm text-mute">All prices in USD. Taxes calculated at checkout. Cancel anytime.</p>
      </div>
    </section>

    {/* ═══════════════ VS NOTEBOOKLM PRICING ═══════════════ */}
    <section class="feature-mesh-band relative overflow-hidden" aria-labelledby="vs-title">
      <div class="absolute inset-0 mesh-gradient-bg opacity-[0.04]" aria-hidden="true"></div>
      <div class="max-w-[1400px] mx-auto px-4 lg:px-8 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <span class="font-caption-mono text-violet-soft uppercase tracking-wider text-xs mb-3 block">Value comparison</span>
            <h2 id="vs-title" class="font-display-lg text-ink mb-4">
              Better value than NotebookLM
            </h2>
            <p class="font-body-lg text-body max-w-2xl mx-auto">
              NotesChatAI gives you more for less. Here's how the pricing stacks up.
            </p>
          </div>

          <div class="bg-canvas rounded-xl border border-hairline shadow-level-3 table-responsive">
            <div class="grid grid-cols-3 bg-canvas-soft border-b border-hairline">
              <div class="p-4"><span class="font-caption-mono text-mute uppercase text-xs tracking-wider">Plan</span></div>
              <div class="p-4 text-center border-x border-hairline">
                <span class="font-body-sm-strong text-ink">NotesChatAI</span>
              </div>
              <div class="p-4 text-center">
                <span class="font-body-sm-strong text-body">NotebookLM</span>
              </div>
            </div>
            {comparisonRows.map((row) => (
              <div class="grid grid-cols-3 border-b border-hairline last:border-b-0 hover:bg-canvas-soft/50 transition-colors">
                <div class="p-4 flex items-center"><span class="font-body-sm-strong text-ink">{row.plan}</span></div>
                <div class="p-4 flex items-center justify-center border-x border-hairline bg-violet/5">
                  <span class="font-body-sm text-ink text-center">{row.nc}</span>
                </div>
                <div class="p-4 flex items-center justify-center">
                  <span class="font-body-sm text-body text-center">{row.nlm}</span>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-6 bg-canvas rounded-lg border border-hairline p-5 flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-success/10 flex items-center justify-center flex-shrink-0">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="text-success" aria-hidden="true">
                <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="2"/>
                <path d="M7 10l3 3 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <p class="font-body-sm-strong text-ink">The bottom line</p>
              <p class="font-body-sm text-body">NotesChatAI Pro at ${PLAN_PRICES.pro.monthly}/mo gives you 500 documents and 300 chats/day. Plus at ${PLAN_PRICES.plus.monthly}/mo gives you unlimited documents and chats. NotebookLM Pro at $19.99/mo still limits you to 300 sources and 500 chats/day. You get more for less with NotesChatAI.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ═══════════════ ENTERPRISE ═══════════════ */}
    <section class="showcase-band-dark relative overflow-hidden" aria-labelledby="enterprise-title">
      {/* Enterprise section intentionally kept for future use */}
      <div class="max-w-[1400px] mx-auto px-4 lg:px-8 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div>
            <span class="font-caption-mono text-cyan-soft uppercase tracking-wider text-xs mb-3 block">Enterprise</span>
            <h2 id="enterprise-title" class="font-display-lg text-on-primary mb-4">
              Need full control?
            </h2>
            <p class="font-body-lg text-cyan-soft mb-6">
              Self-host NotesChatAI on your own infrastructure. Full data sovereignty, custom integrations, and dedicated support.
            </p>
            <ul class="space-y-3 mb-8">
              {[
                'Self-hosted Docker deployment',
                'Custom model hosting (bring your own LLM)',
                'SSO with SAML/OIDC',
                'Audit logs and compliance reports',
                'Dedicated account manager',
                'Custom SLA (99.9%+ uptime)',
                'On-premise option available',
                'Training and onboarding',
              ].map((item) => (
                <li class="flex items-center gap-3 font-body-md text-on-primary/80">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-cyan-soft flex-shrink-0" aria-hidden="true">
                    <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <a href="/contact" class="btn-primary" style="background: white; color: #171717;">Contact Sales</a>
          </div>
          <div class="hidden lg:block">
            <div class="bg-canvas/10 rounded-xl border border-hairline-strong/20 p-8">
              <div class="text-center py-8">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none" class="mx-auto mb-4 text-cyan-soft" aria-hidden="true">
                  <rect x="8" y="8" width="32" height="32" rx="4" stroke="currentColor" stroke-width="2"/>
                  <path d="M18 20h12M18 24h8M18 28h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <p class="font-body-sm-strong text-on-primary mb-1">Self-hosted Docker</p>
                <p class="font-caption text-cyan-soft">Coming soon for Pro & Enterprise plans</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ═══════════════ FAQ ═══════════════ */}
    <section class="showcase-band-light relative" aria-labelledby="faq-title">
      <div class="max-w-[1400px] mx-auto px-4 lg:px-8">
        <div class="text-center mb-12">
          <h2 id="faq-title" class="font-display-lg text-ink mb-4">Frequently Asked Questions</h2>
        </div>

        <div class="max-w-3xl mx-auto space-y-3">
          {[
            {
              q: 'What happens after the free beta ends?',
              a: 'Free tier remains free forever with the same limits. Beta users get 3 months of Pro free when we launch paid plans.',
            },
            {
              q: 'Can I switch plans anytime?',
              a: 'Yes. Upgrade or downgrade anytime. When you upgrade, you get instant access. When you downgrade, the change takes effect at the end of your billing period.',
            },
            {
              q: 'Is my data used for training?',
              a: 'Never. Your documents, chats, and embeddings are never used to train any models. We use pre-trained models only. Your data stays yours.',
            },
            {
              q: 'Can I self-host NotesChatAI?',
              a: 'Yes, Pro and Plus plans include a Docker image for self-hosted deployment. Enterprise customers can also get on-premise installation with dedicated support.',
            },
            {
              q: 'What file formats are supported?',
              a: 'PDF, EPUB, DOCX, TXT, MDX, YouTube URLs, web pages, MP3/WAV audio, and more. We add formats based on user demand.',
            },
            {
              q: 'How does audio overview generation work?',
              a: 'We use a two-host script generation pipeline with high-quality TTS. Each overview includes full transcripts, chapters, speed control, and is saved to your library permanently.',
            },
            {
              q: 'Can I export my data?',
              a: 'Yes. Export to Markdown, PDF, JSON, Anki (.apkg), Obsidian vault, Notion, and CSV. Your data is fully portable.',
            },
            {
              q: 'Do you offer refunds?',
              a: 'Yes. If you\'re not satisfied within the first 14 days of a paid plan, we\'ll give you a full refund. No questions asked.',
            },
          ].map((faq) => (
            <details class="group bg-canvas rounded-lg border border-hairline hover:border-hairline-strong transition-colors">
              <summary class="font-body-md-strong text-ink flex items-center justify-between cursor-pointer list-none p-5">
                {faq.q}
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-mute group-open:rotate-180 transition-transform duration-200 flex-shrink-0 ml-4" aria-hidden="true">
                  <path d="M6 7l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div class="px-5 pb-5 pt-0">
                <p class="font-body-sm text-body leading-relaxed">{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* ═══════════════ FINAL CTA ═══════════════ */}
    <section class="hero-band bg-canvas-soft relative overflow-hidden" aria-labelledby="pricing-cta">
      <div class="absolute inset-0 mesh-gradient-bg opacity-[0.06]" aria-hidden="true"></div>
      <div class="max-w-[1400px] mx-auto px-4 lg:px-8 relative z-10">
        <div class="text-center max-w-2xl mx-auto">
          <h2 id="pricing-cta" class="font-display-lg text-ink mb-4 text-balance">
            Start building your knowledge base today
          </h2>
          <p class="font-body-lg text-body mb-8">
            Free for up to 50 documents. No credit card required. Upgrade anytime.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/auth/signup" class="btn-primary w-full sm:w-auto">Start Free Beta</a>
            <a href="/contact" class="btn-secondary w-full sm:w-auto">Contact Sales</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <UpgradeModal />
</Layout>

<script>
  // Handle upgrade: check auth, then redirect to Stripe Checkout or show modal
  async function handleUpgrade(plan: string) {
    plan = plan || 'pro';
    try {
      const sessionRes = await fetch('/api/auth/session', { credentials: 'include' });
      const sessionData = await sessionRes.json();

      if (!sessionData.session?.user) {
        // Not logged in — send to signup with plan param
        window.location.href = `/auth/signup?plan=${plan}`;
        return;
      }

      // Logged in — try to create Stripe Checkout session
      const checkoutRes = await fetch('/api/billing/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ plan }),
      });
      const checkoutData = await checkoutRes.json();

      if (checkoutRes.ok && checkoutData.url) {
        // Redirect to Stripe Checkout
        window.location.href = checkoutData.url;
      } else if (checkoutRes.status === 503 || checkoutData.error?.includes('not configured')) {
        // Stripe not configured — show upgrade modal
        var showUpgrade = (window as any).showUpgradeModal;
        if (typeof showUpgrade === 'function') showUpgrade();
        else window.location.href = '/app/settings/billing';
      } else if (checkoutRes.status === 400 && checkoutData.error?.includes('already on')) {
        // Already on this plan
        alert(checkoutData.error);
      } else {
        // Other error — show upgrade modal as fallback
        var showUpgrade2 = (window as any).showUpgradeModal;
        if (typeof showUpgrade2 === 'function') showUpgrade2();
        else alert(checkoutData.error || 'Failed to start checkout. Please try again.');
      }
    } catch {
      // Network error — show upgrade modal as fallback
      var showUpgrade3 = (window as any).showUpgradeModal;
      if (typeof showUpgrade3 === 'function') showUpgrade3();
      else window.location.href = '/app/settings/billing';
    }
  }
  // Expose to onclick handlers
  (window as any).handleUpgrade = handleUpgrade;
</script>

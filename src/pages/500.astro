---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/ui/NavBar.astro';
import Footer from '../components/ui/Footer.astro';
---

<Layout title="Server Error — NotesChatAI" description="Something went wrong on our end. We're working on fixing it." robots="noindex">
  <NavBar user={null} />

  <main>
    <section class="hero-band relative overflow-hidden min-h-[60vh] flex items-center" aria-labelledby="500-title">
      <div class="absolute inset-0 mesh-gradient-bg opacity-[0.08]" aria-hidden="true"></div>
      <div class="max-w-[1400px] mx-auto px-4 lg:px-8 relative z-10 w-full">
        <div class="max-w-3xl mx-auto text-center">
          <span class="font-display-xl text-muted/30 block mb-4" aria-hidden="true">500</span>
          <h1 id="500-title" class="font-display-xl text-ink mb-6 text-balance">
            Something went wrong
          </h1>
          <p class="font-body-lg text-body mb-8 text-balance max-w-xl mx-auto">
            We're experiencing a temporary issue. Our team has been notified and is working on a fix.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/" class="btn-primary w-full sm:w-auto">Go Home</a>
            <button onclick="window.location.reload()" class="btn-secondary w-full sm:w-auto">Try Again</button>
          </div>
        </div>
      </div>
    </section>

    <section class="showcase-band-light relative" aria-labelledby="status-title">
      <div class="max-w-[1400px] mx-auto px-4 lg:px-8">
        <div class="max-w-3xl mx-auto text-center">
          <h2 id="status-title" class="font-display-md text-ink mb-4">Need help?</h2>
          <p class="font-body-md text-body mb-6">
            If this keeps happening, please reach out to our support team.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="mailto:support@noteschatai.com" class="btn-primary-sm">Email Support</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
